new file mode 100644
index 0000000000000000000000000000000000000000..204a881a9db8fa347129a2e5d71cd7844f90dc0f
--- /dev/null
+++ b/src/regional_progression.c
@@ -0,0 +1,44 @@
+#include "global.h"
+#include "regional_progression.h"
+#include "regions.h"
+
+static u8 ScaleLevelIntoBand(u8 level, u8 sourceFloor, u8 sourceCeiling, u8 targetFloor, u8 targetCeiling)
+{
+    u32 scaled;
+
+    if (level <= sourceFloor)
+        return targetFloor;
+    if (level >= sourceCeiling)
+        return targetCeiling;
+
+    scaled = targetFloor
+           + ((u32)(level - sourceFloor) * (targetCeiling - targetFloor)
+           + (sourceCeiling - sourceFloor) / 2)
+           / (sourceCeiling - sourceFloor);
+    return (scaled > targetCeiling) ? targetCeiling : scaled;
+}
+
+u8 ScaleLevelForActiveRegion(u8 level)
+{
+    enum Region region = GetActiveRegion();
+
+    // Older saves can predate the persisted campaign region. The map remains
+    // a trustworthy fallback everywhere except the battle-free Transit Hub.
+    if (region == REGION_NONE)
+        region = GetCurrentRegion();
+
+    switch (region)
+    {
+    case REGION_KANTO:
+        // Preserve the level 2-5 opening, then compress the native FRLG curve.
+        if (level <= 5)
+            return level;
+        return ScaleLevelIntoBand(level, 5, 63, 5, 35);
+    case REGION_JOHTO:
+        return ScaleLevelIntoBand(level, 2, 58, 33, 70);
+    case REGION_HOENN:
+        return ScaleLevelIntoBand(level, 2, 58, 70, 100);
+    default:
+        return level;
+    }
+}
