+static enum Move TryLearningRegionalMilestoneMove(struct Pokemon *mon, const struct LevelUpMove *learnset, u32 level)
+{
+    u32 count = 0;
+    u32 firstLateMove;
+    u32 milestone;
+    u32 target;
+
+    // Hoenn occupies levels 70-100. Re-offer seven of the species' latest
+    // natural moves at five-level intervals so growth does not go silent there.
+    if (level < 70 || level > MAX_LEVEL || (level - 70) % 5 != 0)
+        return MOVE_NONE;
+
+    while (learnset[count].move != LEVEL_UP_MOVE_END)
+        count++;
+    if (count == 0)
+        return MOVE_NONE;
+
+    firstLateMove = (count > 7) ? count - 7 : 0;
+    milestone = (level - 70) / 5;
+    target = firstLateMove + ((count - firstLateMove - 1) * milestone) / 6;
+
+    gMoveToLearn = learnset[target].move;
+    if (MonKnowsMove(mon, gMoveToLearn))
+        return MOVE_NONE;
+    return GiveMoveToMon(mon, gMoveToLearn);
+}
