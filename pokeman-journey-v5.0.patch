+"""Validate PokeMan Journey v0.4.4's collection and regional handoffs."""
+
+import json
+import re
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(path):
+    return (ROOT / path).read_text(encoding="utf-8", errors="ignore")
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def balanced_evolution_targets(block):
+    marker = ".evolutions = EVOLUTION("
+    marker_pos = block.find(marker)
+    if marker_pos < 0:
+        return set()
+
+    start = marker_pos + len(marker)
+    depth = 1
+    pos = start
+    while pos < len(block) and depth:
+        depth += (block[pos] == "(") - (block[pos] == ")")
+        pos += 1
+    require(depth == 0, "Unbalanced EVOLUTION macro in Gen 1 species data")
+    return set(re.findall(r"SPECIES_([A-Z0-9_]+)", block[start : pos - 1]))
+
+
+def main():
+    kanto_map_ids = set()
+    kanto_map_dirs = []
+    for map_json in (ROOT / "data/maps").glob("*/map.json"):
+        try:
+            data = json.loads(map_json.read_text(encoding="utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            continue
+        if data.get("region") == "REGION_KANTO":
+            kanto_map_ids.add(data["id"])
+            kanto_map_dirs.append(map_json.parent)
+
+    encounters = json.loads(read("src/data/wild_encounters.json"))
+    species_by_map = {}
+    levels_by_map_species = {}
+    levels_by_label_species = {}
+    direct_sources = set()
+    for group in encounters["wild_encounter_groups"]:
+        for encounter in group.get("encounters", []):
+            map_id = encounter.get("map")
+            if map_id not in kanto_map_ids:
+                continue
+            base_label = encounter.get("base_label")
+            map_species = species_by_map.setdefault(map_id, set())
+            for key, table in encounter.items():
+                if not key.endswith("_mons") or not isinstance(table, dict):
+                    continue
+                for mon in table.get("mons", []):
+                    species = mon["species"].removeprefix("SPECIES_")
+                    map_species.add(species)
+                    direct_sources.add(species)
+                    levels_by_map_species.setdefault((map_id, species), set()).add(
+                        (mon["min_level"], mon["max_level"])
+                    )
+                    levels_by_label_species.setdefault((base_label, species), set()).add(
+                        (mon["min_level"], mon["max_level"])
+                    )
+
+    for map_dir in kanto_map_dirs:
+        script_path = map_dir / "scripts.inc"
+        if script_path.exists():
+            script = script_path.read_text(encoding="utf-8", errors="ignore")
+            direct_sources.update(
+                re.findall(r"(?:givemon|setwildbattle)\s+SPECIES_([A-Z0-9_]+)", script)
+            )
+
+    # These are variable-driven gifts/prizes and therefore do not appear as literal
+    # givemon operands in the map scripts.
+    direct_sources.update({"BULBASAUR", "CYNDAQUIL", "MUDKIP", "PORYGON"})
+
+    dex_section = read("include/constants/pokedex.h").split("// Kanto", 1)[1].split("// Johto", 1)[0]
+    kanto_species = set(re.findall(r"NATIONAL_DEX_([A-Z0-9_]+)", dex_section))
+    require(len(kanto_species) == 151, f"Expected 151 Kanto species, found {len(kanto_species)}")
+
+    species_info = read("src/data/pokemon/species_info/gen_1_families.h")
+    headers = list(re.finditer(r"^\s*\[SPECIES_([A-Z0-9_]+)\]\s*=", species_info, re.MULTILINE))
+    evolution_edges = {}
+    for index, header in enumerate(headers):
+        block_end = headers[index + 1].start() if index + 1 < len(headers) else len(species_info)
+        block = species_info[header.end() : block_end]
+        evolution_edges[header.group(1)] = balanced_evolution_targets(block)
+
+    reachable = set(direct_sources)
+    while True:
+        expanded = reachable | {
+            target
+            for source, targets in evolution_edges.items()
+            if source in reachable
+            for target in targets
+        }
+        if expanded == reachable:
+            break
+        reachable = expanded
+
+    # v5.0 deliberately moves the unique Mew acquisition to the final
+    # all-24-badge Faraway Island reward.  It is still obtainable in the
+    # complete game, but no longer has a duplicate Kanto-local encounter.
+    missing = sorted((kanto_species - {"MEW"}) - reachable)
+    require(not missing, "Unobtainable Kanto species: " + ", ".join(missing))
+
+    expected_rare_encounters = {
+        "MAP_THREE_ISLAND_BERRY_FOREST": {"FARFETCHD": (37, 37), "MR_MIME": (35, 35)},
+        "MAP_SAFARI_ZONE_WEST": {"LICKITUNG": (23, 23)},
+        "MAP_SEAFOAM_ISLANDS_B4F": {"JYNX": (36, 36), "SQUIRTLE": (32, 32)},
+        "MAP_MT_EMBER_EXTERIOR": {"CHARMANDER": (38, 38)},
+        "MAP_VICTORY_ROAD_1F_FRLG": {"HITMONLEE": (46, 46), "HITMONCHAN": (46, 46)},
