+    for map_id, expected_species in expected_rare_encounters.items():
+        missing_here = set(expected_species) - species_by_map.get(map_id, set())
+        require(not missing_here, f"{map_id} is missing rare encounters: {sorted(missing_here)}")
+        for species, expected_levels in expected_species.items():
+            actual_levels = levels_by_map_species.get((map_id, species), set())
+            require(
+                actual_levels == {expected_levels},
+                f"{map_id} {species} levels are {sorted(actual_levels)}, expected {expected_levels}",
+            )
+
+    expected_route_six = {
+        "sRoute6_FireRed": {"EEVEE": (16, 16), "DRATINI": (16, 16), "SCYTHER": (17, 17)},
+        "sRoute6_LeafGreen": {"EEVEE": (16, 16), "DRATINI": (16, 16), "PINSIR": (17, 17)},
+    }
+    for base_label, expected_species in expected_route_six.items():
+        for species, expected_levels in expected_species.items():
+            actual_levels = levels_by_label_species.get((base_label, species), set())
+            require(
+                actual_levels == {expected_levels},
+                f"{base_label} {species} levels are {sorted(actual_levels)}, expected {expected_levels}",
+            )
+
+    route_one_starters = {"BULBASAUR", "CHARMANDER", "SQUIRTLE"} & species_by_map.get("MAP_ROUTE1", set())
+    require(not route_one_starters, f"Route 1 still gives away starters: {sorted(route_one_starters)}")
+
+    for target in ("ALAKAZAM", "MACHAMP", "GOLEM", "GENGAR"):
+        require(
+            f"ITEM_MOON_STONE, SPECIES_{target}" in species_info,
+            f"{target} still lacks its no-trade Moon Stone evolution",
+        )
+
+    cerulean_mew_script = read("data/maps/CeruleanCave_B1F_Frlg/scripts.inc")
+    require(
+        not re.search(r"\bSPECIES_MEW\b", cerulean_mew_script),
+        "Cerulean Cave still contains a duplicate Mew path",
+    )
+    faraway_mew_script = read("data/maps/FarawayIsland_Interior/scripts.inc")
+    for token in (
+        "FinalMewReward_ScrCheckUnlocked",
+        "FinalMewReward_ScrCreateEncounter",
+        "B_OUTCOME_CAUGHT",
+        "setflag FLAG_CAUGHT_MEW",
+        "setflag FLAG_V04_FOUGHT_MEW",
+    ):
