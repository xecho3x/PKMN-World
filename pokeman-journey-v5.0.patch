 	.byte 0
 
+@ FLAG_UNUSED_0x1AA is deliberately reserved as the one-time Jirachi caught
+@ marker. The encounter sits behind Waterfall in Meteor Falls and remains
+@ available after a defeat or escape, so a single-save Pokédex cannot be lost.
+MeteorFalls_B1F_2R_EventScript_Jirachi::
+	lock
+	faceplayer
+	msgbox MeteorFalls_B1F_2R_Text_WishingStar, MSGBOX_DEFAULT
+	playmoncry SPECIES_JIRACHI, CRY_MODE_ENCOUNTER
+	waitmoncry
+	seteventmon SPECIES_JIRACHI, 30
+	special BattleSetup_StartLegendaryBattle
+	waitstate
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, MeteorFalls_B1F_2R_EventScript_JirachiRetry
+	fadescreenswapbuffers FADE_TO_BLACK
+	setflag FLAG_UNUSED_0x1AA
+	removeobject LOCALID_METEOR_FALLS_JIRACHI
+	fadescreenswapbuffers FADE_FROM_BLACK
+	msgbox MeteorFalls_B1F_2R_Text_WishGranted, MSGBOX_DEFAULT
+	release
+	end
+
+MeteorFalls_B1F_2R_EventScript_JirachiRetry::
+	msgbox MeteorFalls_B1F_2R_Text_WishReturns, MSGBOX_DEFAULT
+	release
+	end
+
+MeteorFalls_B1F_2R_Text_WishingStar:
+	.string "A tiny star awakens in the deepest\n"
+	.string "chamber of METEOR FALLS!\p"
+	.string "JIRACHI wants to test the strength\n"
+	.string "of your wish.$"
+
+MeteorFalls_B1F_2R_Text_WishGranted:
+	.string "Your wish reached JIRACHI.\n"
+	.string "It chose to travel with you!$"
+
+MeteorFalls_B1F_2R_Text_WishReturns:
+	.string "The star's light fades, but does not\n"
+	.string "disappear. JIRACHI will return.$"
