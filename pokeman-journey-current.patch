     }
 }
 
+static void TryAnnoyActivation(enum BattlerId battlerAtk, enum BattlerId effectBattler, enum MoveEffect effect, enum StatusTrigger trigger)
+{
+    // Annoy only answers a status directly delivered by an opposing move.
+    // This source check deliberately rejects Rest/self effects, partners,
+    // hazards, weather, held items, Protect contact effects, and ability
+    // reflections while preserving the exact attacker in double battles.
+    if (trigger != TRIGGER_ON_MOVE
+     || battlerAtk == effectBattler
+     || IsBattlerAlly(battlerAtk, effectBattler)
+     || GetBattlerAbility(effectBattler) != ABILITY_ANNOY)
+        return;
+
+    switch (effect)
+    {
+    case MOVE_EFFECT_SLEEP:
+    case MOVE_EFFECT_POISON:
+    case MOVE_EFFECT_BURN:
+    case MOVE_EFFECT_FREEZE:
+    case MOVE_EFFECT_PARALYSIS:
+    case MOVE_EFFECT_TOXIC:
+    case MOVE_EFFECT_FROSTBITE:
+        gBattleStruct->annoyState = ANNOY_STATE_START;
+        gBattleStruct->annoyBattler = effectBattler;
+        gBattleStruct->annoySource = battlerAtk;
+        break;
+    default:
+        break;
+    }
+}
+
 static void SetNonVolatileStatus(enum BattlerId battlerAtk, enum BattlerId effectBattler, enum MoveEffect effect, const u8 *battleScript, enum StatusTrigger trigger)
 {
     gEffectBattler = effectBattler;
@@ -2221,6 +2251,7 @@ static void SetNonVolatileStatus(enum BattlerId battlerAtk, enum BattlerId effec
     gBattleScripting.moveEffect = MOVE_EFFECT_NONE;
 
     TrySynchronizeActivation(battlerAtk, effectBattler, effect);
+    TryAnnoyActivation(battlerAtk, effectBattler, effect, trigger);
 
     if ((effect == MOVE_EFFECT_POISON || effect == MOVE_EFFECT_TOXIC) && trigger == TRIGGER_ON_MOVE)
         gSpecialStatuses[effectBattler].poisonPuppeteer = TRUE;
@@ -10703,6 +10734,50 @@ static void Cmd_trysynchronize(void)
     CMD_ARGS();
     enum MoveEffect synchStatus = MOVE_EFFECT_NONE;
 
+    // Status-result scripts already funnel through this command. Process the
+    // pending Annoy response here, after the status was actually committed,
+    // without adding a second command to every status battle script.
+    if (gBattleStruct->synchronizeState == SYNCH_STATE_NONE
+     && gBattleStruct->annoyState != ANNOY_STATE_NONE)
+    {
+        enum BattlerId annoyBattler = gBattleStruct->annoyBattler;
+        enum BattlerId annoySource = gBattleStruct->annoySource;
+
+        switch (gBattleStruct->annoyState)
+        {
+        case ANNOY_STATE_START:
+            gBattlerAbility = annoyBattler;
+            gBattleScripting.battler = annoyBattler;
+            gEffectBattler = annoySource;
+            RecordAbilityBattle(annoyBattler, ABILITY_ANNOY);
+            PlayCry_Normal(gBattleMons[annoyBattler].species, 0);
+
+            if (CanBeConfused(annoyBattler, annoySource))
+            {
+                gBattleScripting.moveEffect = MOVE_EFFECT_CONFUSION;
+                gBattleStruct->annoyState = ANNOY_STATE_SET_CONFUSION;
+                BattleScriptCall(BattleScript_AnnoyActivates);
+            }
+            else
+            {
+                // The bark and popup still show that Annoy answered; native
+                // confusion immunity/protection prevents the volatile status.
+                gBattleStruct->annoyState = ANNOY_STATE_END;
+                BattleScriptCall(BattleScript_AnnoyBlocked);
