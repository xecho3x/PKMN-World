+
+    erika = read("data/maps/CeladonCity_Gym_Frlg/scripts.inc")
+    blaine = read("data/maps/CinnabarIsland_Gym_Frlg/scripts.inc")
+    require("FLAG_V04_KANTO_STARTER_BADGE4" in erika, "Erika's starter reward is missing")
+    require("FLAG_V04_KANTO_STARTER_BADGE7" in blaine, "Blaine's starter reward is missing")
+    require("givemon VAR_0x8004, 22" in erika and "SPECIES_PSYSHELL" in erika,
+            "Erika does not offer unchosen Psyshell at level 22")
+    require("MtEmberStarterHint" in blaine, "Blaine does not point to the Mt. Ember starter")
+    require("givemon SPECIES_AMPHID, 25" in read("data/maps/SeafoamIslands_B4F_Frlg/scripts.inc"),
+            "Seafoam does not offer unchosen Amphid at level 25")
+    require("givemon SPECIES_JOEYRO, 30" in read("data/maps/MtEmber_Exterior_Frlg/scripts.inc"),
+            "Mt. Ember does not offer unchosen Joeyro at level 30")
+
+    for species in ("OMANYTE", "KABUTO", "AERODACTYL"):
+        require(
+            f"givemon SPECIES_{species}, 35" in fossil_script,
+            f"Cinnabar's {species} fossil revival is not level 35",
