+
+    rival_parties = read("src/data/trainers_frlg.party")
+    expected_rival_families = {
+        "SQUIRTLE": {"Mudkip", "Marshtomp", "Swampert"},
+        "BULBASAUR": {"Bulbasaur", "Ivysaur", "Venusaur"},
+        "CHARMANDER": {"Cyndaquil", "Quilava", "Typhlosion"},
+    }
+    rival_sections_checked = 0
+    for match in re.finditer(
+        r"^=== (TRAINER_(?:RIVAL|CHAMPION)[A-Z0-9_]+_(SQUIRTLE|BULBASAUR|CHARMANDER)) ===\n(.*?)(?=^=== |\Z)",
+        rival_parties,
+        re.MULTILINE | re.DOTALL,
+    ):
+        trainer_name, variant, section = match.groups()
+        mons = re.findall(r"^([A-Za-z][A-Za-z0-9 ._-]*?)(?: @ [^\n]+)?\nLevel:", section, re.MULTILINE)
+        require(mons, f"{trainer_name} has no party members")
+        require(
+            mons[-1] in expected_rival_families[variant],
+            f"{trainer_name} ends with {mons[-1]}, which does not match Gary's chosen starter",
+        )
+        move_blocks = re.findall(
+            r"^[A-Za-z][A-Za-z0-9 ._-]*?(?: @ [^\n]+)?\nLevel:.*?\nIVs:.*?\n(?:Ability:.*?\n)?((?:- [^\n]+\n)*)",
+            section,
+            re.MULTILINE,
+        )
+        for moves in move_blocks:
+            require(
+                len(moves.splitlines()) <= 4,
+                f"{trainer_name} has a Pokémon with more than four moves",
+            )
+        rival_sections_checked += 1
+    require(rival_sections_checked >= 30, f"Only checked {rival_sections_checked} Gary starter teams")
+
+    new_bark = read("data/maps/NewBarkTown_Lab/scripts.inc")
+    for species in ("CHARMANDER", "TOTODILE", "TREECKO"):
+        require(f"SPECIES_{species}" in new_bark, f"Johto starter trio is missing {species}")
+    require("givemon PLAYER_STARTER_SPECIES, 5" in new_bark, "Johto starter is not level 5")
+
+    route29 = next(
+        encounter
+        for group in encounters["wild_encounter_groups"]
+        for encounter in group.get("encounters", [])
+        if encounter.get("map") == "MAP_ROUTE29"
+    )
+    route29_species = {
+        mon["species"]
+        for table_name, table in route29.items()
+        if table_name.endswith("_mons") and isinstance(table, dict)
+        for mon in table.get("mons", [])
+    }
+    require(
+        not route29_species & {"SPECIES_CHARMANDER", "SPECIES_TOTODILE", "SPECIES_TREECKO", "SPECIES_CHIKORITA", "SPECIES_CYNDAQUIL", "SPECIES_SQUIRTLE", "SPECIES_TORCHIC", "SPECIES_MUDKIP", "SPECIES_BULBASAUR"},
+        "Route 29 still gives away a regional starter",
+    )
+
+    starter_choose = read("src/starter_choose.c")
+    require(
+        "[REGION_HOENN] = { SPECIES_CHIKORITA,  SPECIES_TORCHIC,   SPECIES_SQUIRTLE }" in starter_choose,
+        "Hoenn does not use the final Chikorita/Torchic/Squirtle trio",
+    )
+    for path, first_flag, second_flag in (
+        ("data/maps/AzaleaTown_Gym/scripts.inc", "FLAG_GOT_JOHTO_STARTER_REWARD_1", None),
+        ("data/maps/OlivineCity_Gym/scripts.inc", "FLAG_GOT_JOHTO_STARTER_REWARD_2", None),
+        ("data/maps/LavaridgeTown_Gym_1F/scripts.inc", "FLAG_HOENN_STARTER_REWARD_1", None),
+        ("data/maps/FortreeCity_Gym/scripts.inc", "FLAG_HOENN_STARTER_REWARD_2", None),
+    ):
+        require(first_flag in read(path), f"Regional starter reward is missing from {path}")
+
+    olivine_port = read("data/maps/OlivineCity_PortInside/scripts.inc")
+    for token in (
+        "FLAG_JOHTO_CHAMPION",
+        "RegionHub_ScrHoennIntroDone",
+        "RegionHub_ScrEnterRegion",
+        "MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F",
+        "MAP_LITTLEROOT_TOWN_MAYS_HOUSE_2F",
+    ):
+        require(token in olivine_port, f"Johto-to-Hoenn transition is missing {token}")
+
+    progression = read("src/regional_progression.c")
+    for token in ("REGION_KANTO", "REGION_JOHTO", "REGION_HOENN", "5, 35", "33, 70", "70, 100"):
+        require(token in progression, f"Regional level scaling is missing {token}")
+
+    caps = read("src/caps.c")
+    for token in ("10, 13, 16", "37, 41, 45", "73, 77, 81", "leagueCap = 35", "leagueCap = 70"):
+        require(token in caps, f"Regional cap curve is missing {token}")
+
+    pokemon = read("src/pokemon.c")
+    require("TryLearningRegionalMilestoneMove" in pokemon, "High-level milestone moves are disabled")
+    require(
+        "#define P_ENABLE_ALL_LEVEL_UP_MOVES      TRUE" in read("include/config/summary_screen.h"),
+        "The move reminder cannot recover missed high-level moves",
+    )
+
+    print("v5.2 validation passed: custom starters, transitions, collection, regional progression, and final Mew are correct.")
+
+
+if __name__ == "__main__":
+    main()
