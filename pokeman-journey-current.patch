diff --git a/test/battle/ability/annoy.c b/test/battle/ability/annoy.c
new file mode 100644
index 0000000000000000000000000000000000000000..64196c922b457be35f60fee10d1e6cde7d4faa47
--- /dev/null
+++ b/test/battle/ability/annoy.c
@@ -0,0 +1,219 @@
+#include "global.h"
+#include "test/battle.h"
+
+SINGLE_BATTLE_TEST("Annoy confuses the opposing source of a direct major status")
+{
+    enum Move move;
+
+    PARAMETRIZE { move = MOVE_WILL_O_WISP; }
+    PARAMETRIZE { move = MOVE_POISON_GAS; }
+    PARAMETRIZE { move = MOVE_TOXIC; }
+    PARAMETRIZE { move = MOVE_THUNDER_WAVE; }
+    PARAMETRIZE { move = MOVE_HYPNOSIS; }
+
+    GIVEN {
+        ASSUME(GetMoveEffect(move) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, move); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(player->status1 & STATUS1_ANY);
+        EXPECT(opponent->volatiles.confusionTurns > 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy answers freeze or frostbite")
+{
+    GIVEN {
+        ASSUME(MoveHasAdditionalEffect(MOVE_POWDER_SNOW, MOVE_EFFECT_FREEZE_OR_FROSTBITE));
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_POWDER_SNOW, WITH_RNG(RNG_SECONDARY_EFFECT, TRUE)); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(player->status1 & (STATUS1_FREEZE | STATUS1_FROSTBITE));
+        EXPECT(opponent->volatiles.confusionTurns > 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy does not activate from Rest")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_REST) == EFFECT_REST);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); HP(1); MaxHP(300); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(player, MOVE_REST); }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(player, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        }
+    } THEN {
+        EXPECT(player->status1 & STATUS1_SLEEP);
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy does not activate from Toxic Spikes")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_TOXIC_SPIKES) == EFFECT_TOXIC_SPIKES);
+        PLAYER(SPECIES_WOBBUFFET);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_TOXIC_SPIKES); }
+        TURN { SWITCH(player, 1); }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(player, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        }
+    } THEN {
+        EXPECT(player->status1 & STATUS1_POISON);
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy does not activate from held status orbs")
+{
+    enum Item item;
+
+    PARAMETRIZE { item = ITEM_FLAME_ORB; }
+    PARAMETRIZE { item = ITEM_TOXIC_ORB; }
+
+    GIVEN {
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); Item(item); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(player, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        }
+    } THEN {
+        EXPECT(player->status1 & STATUS1_ANY);
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy does not activate when the status attempt fails")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); Status1(STATUS1_BURN); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_WILL_O_WISP); }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(player, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        }
+    } THEN {
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+DOUBLE_BATTLE_TEST("Annoy does not activate when an ally supplies the status")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        PLAYER(SPECIES_WYNAUT);
+        OPPONENT(SPECIES_WOBBUFFET);
+        OPPONENT(SPECIES_WYNAUT);
+    } WHEN {
+        TURN { MOVE(playerRight, MOVE_WILL_O_WISP, target: playerLeft); }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(playerLeft, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, playerRight);
+        }
+    } THEN {
+        EXPECT(playerLeft->status1 & STATUS1_BURN);
+        EXPECT(playerRight->volatiles.confusionTurns == 0);
+    }
+}
+
+DOUBLE_BATTLE_TEST("Annoy confuses only the opposing battler that supplied the status")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        PLAYER(SPECIES_WYNAUT);
+        OPPONENT(SPECIES_WOBBUFFET);
+        OPPONENT(SPECIES_WYNAUT);
+    } WHEN {
+        TURN { MOVE(opponentRight, MOVE_WILL_O_WISP, target: playerLeft); }
+    } SCENE {
+        ABILITY_POPUP(playerLeft, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponentRight);
+        NOT ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponentLeft);
+    } THEN {
+        EXPECT(opponentLeft->volatiles.confusionTurns == 0);
+        EXPECT(opponentRight->volatiles.confusionTurns > 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy respects Own Tempo confusion immunity")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_SLOWPOKE) { Ability(ABILITY_OWN_TEMPO); }
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_WILL_O_WISP); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        NOT ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy respects Substitute confusion protection")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_SUBSTITUTE); }
+        TURN { MOVE(opponent, MOVE_WILL_O_WISP); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        NOT ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy can activate again after both statuses are cured")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_POISON_GAS) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); Item(ITEM_LUM_BERRY); }
+        OPPONENT(SPECIES_WOBBUFFET) { Item(ITEM_PERSIM_BERRY); }
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_POISON_GAS); }
+        TURN { MOVE(opponent, MOVE_POISON_GAS); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(player->status1 & STATUS1_POISON);
+        EXPECT(opponent->volatiles.confusionTurns > 0);
+    }
+}
diff --git a/Testing/ValidateCanonicalV54.py b/Testing/ValidateCanonicalV54.py
new file mode 100644
index 0000000000000000000000000000000000000000..cda681ee1d9943fd01bf9bddaf866960851401f6
--- /dev/null
+++ b/Testing/ValidateCanonicalV54.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Static release checks for PokeMan Journey v5.4's canonical-roster reset."""
+
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+
+CUSTOM = (
+    "PHYCUB", "EMBRUIN", "INFERNURSA",
+    "PSYSHELL", "VERDACHELL", "ASTRACHELL",
+    "AMPHID", "AMPHLUME", "AMPHIDRAKE",
+    "JOEYRO", "KICKAROO", "KANGAROOZE",
+    "FINTOM", "HAUNTIDE", "SHARKRAITH",
+    "DANYIP", "DANNY", "DANIMAL",
+)
+
+
+def read(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise SystemExit(f"v5.4 canonical validation failed: {message}")
+
+
+starters = read("src/starter_choose.c")
+require(
+    re.search(
+        r"\[REGION_KANTO\]\s*=\s*\{\s*SPECIES_BULBASAUR,\s*"
+        r"SPECIES_MUDKIP,\s*SPECIES_CYNDAQUIL\s*\}",
+        starters,
+    ) is not None,
+    "Kanto starter trio is not Bulbasaur/Mudkip/Cyndaquil",
+)
+
+oak = read("data/maps/PalletTown_ProfessorOaksLab_Frlg/scripts.inc")
+for expected in (
+    "setvar PLAYER_STARTER_SPECIES, SPECIES_BULBASAUR",
+    "setvar RIVAL_STARTER_SPECIES, SPECIES_CYNDAQUIL",
+    "setvar PLAYER_STARTER_SPECIES, SPECIES_MUDKIP",
+    "setvar RIVAL_STARTER_SPECIES, SPECIES_BULBASAUR",
+    "setvar PLAYER_STARTER_SPECIES, SPECIES_CYNDAQUIL",
+    "setvar RIVAL_STARTER_SPECIES, SPECIES_MUDKIP",
+):
+    require(expected in oak, f"Oak's Lab is missing: {expected}")
+
+acquisition_files = (
+    "src/data/wild_encounters.json",
+    "src/starter_choose.c",
+    "src/battle_main.c",
+    "src/data/trainers.party",
+    "src/data/trainers_frlg.party",
+    "data/maps/PalletTown_ProfessorOaksLab_Frlg/scripts.inc",
+    "data/maps/CeladonCity_Gym_Frlg/scripts.inc",
+    "data/maps/SeafoamIslands_B4F_Frlg/scripts.inc",
+    "data/maps/MtEmber_Exterior_Frlg/scripts.inc",
+)
+for path in acquisition_files:
+    contents = read(path)
+    for name in CUSTOM:
+        require(f"SPECIES_{name}" not in contents, f"{name} remains obtainable via {path}")
+
+wild = read("src/data/wild_encounters.json")
+require("SPECIES_TENTACRUEL" in wild, "Abandoned Ship Tentacruel was not restored")
+require("SPECIES_PARAS" in wild, "Mt. Moon Paras was not restored")
+
+erika = read("data/maps/CeladonCity_Gym_Frlg/scripts.inc")
+for species in ("SPECIES_BULBASAUR", "SPECIES_MUDKIP", "SPECIES_CYNDAQUIL"):
+    require(species in erika, f"Erika's official starter recovery is missing {species}")
+
+elm = read("data/maps/NewBarkTown_Lab/scripts.inc")
+for expected in (
+    "goto_if_unset FLAG_JOHTO_STARTER_CHOSEN, NewBarkTown_Lab_EventScript_ElmContinueJohtoStory",
+    "goto_if_unset FLAG_KANTO_CHAMPION, NewBarkTown_Lab_EventScript_ElmOfferEarlyKantoReturn",
+    "goto_if_eq VAR_RESULT, NO, NewBarkTown_Lab_EventScript_ElmContinueJohtoStory",
+    "callnative RegionHub_ScrCanDepositParty",
+    "callnative RegionHub_ScrEnterRegion",
+    "setrespawn HEAL_LOCATION_CINNABAR_ISLAND",
+    "warp MAP_CINNABAR_ISLAND, 14, 12",
+):
+    require(expected in elm, f"early Elm return is missing: {expected}")
+
+hub = read("data/maps/RegionHub/scripts.inc")
+require(
+    "goto_if_unset FLAG_VISITED_GOLDENROD_CITY, RegionHub_EventScript_ReturnJohtoNewBark" in hub,
+    "an early HUB PASS return can skip ahead to Goldenrod",
+)
+require(
+    "RegionHub_EventScript_ReturnJohtoNewBark::\n\twarp MAP_NEW_BARK_TOWN, 0" in hub,
+    "the early Johto resume does not return to New Bark Town",
+)
+
+require("NEW GAME  V5.4.1" in read("src/main_menu.c"), "main menu version is not v5.4.1")
+require("POKEMAN V541" in read("Makefile"), "ROM header title is not v5.4.1")
+require("REVISION    := 16" in read("Makefile"), "ROM revision is not v5.4.1 revision 16")
+require(
+    "FILE_NAME := pokeman_journey_v541_early_return" in read("Makefile"),
+    "ROM output filename is not the v5.4.1 early-return build",
+)
+
+print("v5.4 canonical roster validation passed")
diff --git a/Testing/ValidateDanyipLine.py b/Testing/ValidateDanyipLine.py
new file mode 100644
index 0000000000000000000000000000000000000000..51783ce4603db5776276566fcc01657020583b58
