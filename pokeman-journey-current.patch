+static u16 EvIvChangerTotalEvs(struct Pokemon *mon)
+{
+    u8 i;
+    u16 total = 0;
+
+    for (i = 0; i < NUM_STATS; i++)
+        total += GetMonData(mon, sEvIvChangerEvMonData[i]);
+    return total;
+}
