+	faceplayer
+	msgbox TinTower_1F_Text_SuicuneChallenge, MSGBOX_DEFAULT
+	playmoncry SPECIES_SUICUNE, CRY_MODE_ENCOUNTER
+	waitmoncry
+	seteventmon SPECIES_SUICUNE, 50
+	special BattleSetup_StartLegendaryBattle
+	waitstate
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, TinTower_1F_EventScript_SuicuneRetry
+	fadescreenswapbuffers FADE_TO_BLACK
+	setflag FLAG_FOUGHT_SUICUNE
+	setflag FLAG_HIDE_ROUTE25_SUICUNE
+	removeobject LOCALID_TIN_TOWER_SUICUNE
+	fadescreenswapbuffers FADE_FROM_BLACK
+	msgbox TinTower_1F_Text_SuicuneCaught, MSGBOX_DEFAULT
+	release
+	end
+
+TinTower_1F_EventScript_SuicuneRetry::
+	msgbox TinTower_1F_Text_SuicuneRetry, MSGBOX_DEFAULT
+	release
