+        "REGION_HOENN",
+        "badge < NUM_BADGES",
+        "SPECIES_MEW, 80",
+        "NATURE_TIMID",
+        "MAX_PER_STAT_IVS",
+        "MON_DATA_HP_EV",
+        "MON_DATA_SPATK_EV",
+        "MON_DATA_SPEED_EV",
+        "MOVE_PSYCHIC",
+        "MOVE_AURA_SPHERE",
+        "MOVE_ICE_BEAM",
+        "MOVE_FLAMETHROWER",
