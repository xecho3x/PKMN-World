+"""Build the nine v5.5 custom species assets from the approved line atlases.
+
+The generated source atlases are intentionally kept outside the runtime graphics
+tree.  This script removes their neutral checkerboard, crops each front/back
+cell, and writes deterministic 4bpp-friendly indexed PNGs and JASC palettes.
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from pathlib import Path
+
+from PIL import Image, ImageOps
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE_ROOT = ROOT / "assets" / "v5.5_source_atlases"
+OUTPUT_ROOT = ROOT / "graphics" / "pokemon"
+
+TRANSPARENT = (0, 255, 0)
+
+WATER = [
+    TRANSPARENT, (8, 18, 52), (10, 42, 98), (8, 72, 150),
+    (16, 108, 194), (48, 154, 222), (93, 197, 235), (168, 236, 232),
+    (22, 92, 112), (54, 140, 148), (112, 198, 184), (205, 248, 238),
+    (72, 63, 138), (142, 125, 204), (226, 238, 255), (255, 255, 255),
+]
+WATER_SHINY = [
+    TRANSPARENT, (35, 12, 55), (70, 24, 105), (104, 45, 150),
+    (145, 66, 188), (190, 94, 210), (230, 145, 226), (252, 202, 238),
+    (94, 42, 82), (145, 67, 101), (210, 112, 122), (255, 190, 170),
+    (44, 94, 112), (86, 160, 162), (220, 246, 230), (255, 255, 255),
+]
+GRASS = [
+    TRANSPARENT, (18, 25, 15), (35, 45, 24), (55, 66, 31),
+    (77, 86, 38), (103, 108, 51), (132, 132, 67), (166, 158, 92),
+    (25, 66, 26), (35, 100, 34), (54, 139, 43), (82, 181, 61),
+    (128, 220, 91), (181, 238, 137), (218, 214, 163), (251, 246, 211),
+]
+GRASS_SHINY = [
+    TRANSPARENT, (28, 18, 13), (55, 31, 19), (82, 48, 24),
+    (111, 65, 30), (144, 86, 38), (180, 111, 46), (214, 145, 66),
+    (69, 34, 65), (103, 48, 94), (139, 68, 121), (178, 94, 151),
+    (216, 129, 180), (239, 173, 207), (238, 207, 161), (255, 244, 212),
+]
+FIRE = [
+    TRANSPARENT, (30, 15, 10), (76, 27, 13), (126, 41, 13),
+    (180, 53, 12), (226, 73, 11), (249, 109, 17), (255, 160, 32),
+    (255, 211, 70), (91, 52, 28), (139, 82, 41), (200, 137, 69),
+    (246, 203, 124), (255, 237, 188), (188, 29, 25), (255, 255, 255),
+]
+FIRE_SHINY = [
+    TRANSPARENT, (10, 22, 35), (15, 49, 75), (20, 78, 116),
+    (22, 111, 151), (35, 151, 187), (68, 194, 218), (124, 226, 235),
+    (203, 249, 244), (47, 54, 62), (79, 91, 99), (130, 146, 151),
+    (196, 210, 208), (241, 249, 242), (104, 66, 160), (255, 255, 255),
+]
+
+ICON_PALETTES = {
+    0: [(98,156,131),(131,131,115),(189,189,189),(255,255,255),(189,164,65),(246,246,41),(213,98,65),(246,148,41),(139,123,255),(98,74,205),(238,115,156),(255,180,164),(164,197,255),(106,172,156),(98,98,90),(65,65,65)],
+    1: [(98,156,131),(115,115,115),(189,189,189),(255,255,255),(123,156,74),(156,205,74),(148,246,74),(238,115,156),(246,148,246),(189,164,90),(246,230,41),(246,246,172),(213,213,106),(230,74,41),(98,98,90),(65,65,65)],
+    3: [(98,156,131),(115,115,115),(189,189,189),(255,255,255),(65,106,148),(98,148,164),(164,197,255),(238,115,156),(213,98,65),(189,164,90),(246,230,41),(246,246,172),(213,213,106),(246,148,41),(98,98,90),(65,65,65)],
+}
+
+LINES = [
+    ("tide_line.png", ["finrush", "riptalon", "tsunamight"], WATER, WATER_SHINY, 3, [42, 54, 64]),
+    ("stone_line.png", ["geckore", "craguan", "monolisk"], GRASS, GRASS_SHINY, 1, [42, 54, 64]),
+    ("ember_line.png", ["kindlet", "raptorch", "pyrenix"], FIRE, FIRE_SHINY, 0, [42, 54, 64]),
+]
+
+
+def is_neutral_background(pixel: tuple[int, int, int, int]) -> bool:
+    r, g, b, _ = pixel
+    return min(r, g, b) >= 220 and max(r, g, b) - min(r, g, b) <= 8
+
+
+def remove_checkerboard(image: Image.Image) -> Image.Image:
+    rgba = image.convert("RGBA")
+    pixels = rgba.load()
+    width, height = rgba.size
+    queue: deque[tuple[int, int]] = deque()
+    seen: set[tuple[int, int]] = set()
+    for x in range(width):
+        queue.append((x, 0)); queue.append((x, height - 1))
+    for y in range(height):
+        queue.append((0, y)); queue.append((width - 1, y))
+    while queue:
+        x, y = queue.popleft()
+        if (x, y) in seen or not is_neutral_background(pixels[x, y]):
+            continue
+        seen.add((x, y))
+        pixels[x, y] = (0, 255, 0, 0)
+        if x: queue.append((x - 1, y))
+        if x + 1 < width: queue.append((x + 1, y))
+        if y: queue.append((x, y - 1))
+        if y + 1 < height: queue.append((x, y + 1))
+    return rgba
+
+
+def crop_cell(atlas: Image.Image, column: int, row: int) -> Image.Image:
+    cell_w = atlas.width // 2
+    cell_h = atlas.height // 3
+    cell = atlas.crop((column * cell_w, row * cell_h, (column + 1) * cell_w, (row + 1) * cell_h))
+    # Generated atlases occasionally let the next row protrude a few pixels
+    # across the mathematical grid boundary.  Keep only the largest connected
+    # opaque component so that a neighboring head/wing cannot leak into a ROM
+    # sprite.
+    alpha = cell.getchannel("A")
+    opaque = alpha.load()
+    visited: set[tuple[int, int]] = set()
+    largest: list[tuple[int, int]] = []
+    for seed_y in range(cell.height):
+        for seed_x in range(cell.width):
+            if opaque[seed_x, seed_y] < 128 or (seed_x, seed_y) in visited:
+                continue
+            component: list[tuple[int, int]] = []
+            queue = deque([(seed_x, seed_y)])
+            visited.add((seed_x, seed_y))
+            while queue:
+                x, y = queue.popleft()
+                component.append((x, y))
+                for nx, ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
+                    if 0 <= nx < cell.width and 0 <= ny < cell.height and opaque[nx, ny] >= 128 and (nx, ny) not in visited:
+                        visited.add((nx, ny)); queue.append((nx, ny))
+            if len(component) > len(largest):
+                largest = component
+    if largest:
+        keep = set(largest)
+        cell_pixels = cell.load()
+        for y in range(cell.height):
+            for x in range(cell.width):
+                if (x, y) not in keep:
+                    r, g, b, _ = cell_pixels[x, y]
+                    cell_pixels[x, y] = (r, g, b, 0)
+    alpha = cell.getchannel("A")
+    box = alpha.getbbox()
+    if box is None:
+        raise RuntimeError(f"Empty atlas cell {column}, {row}")
+    return cell.crop(box)
+
+
+def fit(source: Image.Image, size: tuple[int, int], max_size: int, y_offset: int = 0) -> Image.Image:
+    source = source.copy()
+    source.thumbnail((max_size, max_size), Image.Resampling.NEAREST)
+    canvas = Image.new("RGBA", size, (0, 255, 0, 0))
+    x = (size[0] - source.width) // 2
+    y = size[1] - source.height + y_offset
+    canvas.alpha_composite(source, (x, y))
+    return canvas
+
+
+def indexed(image: Image.Image, palette: list[tuple[int, int, int]]) -> Image.Image:
+    rgb = image.convert("RGBA")
+    output = Image.new("P", rgb.size, 0)
+    flat = [component for color in palette for component in color] + [0] * (768 - 3 * len(palette))
+    output.putpalette(flat)
+    src = rgb.load(); dst = output.load()
+    for y in range(rgb.height):
+        for x in range(rgb.width):
+            r, g, b, a = src[x, y]
+            if a < 128:
+                dst[x, y] = 0
+                continue
+            start = 1 if palette[0] == TRANSPARENT else 0
+            dst[x, y] = min(range(start, len(palette)), key=lambda i: (r-palette[i][0])**2 + (g-palette[i][1])**2 + (b-palette[i][2])**2)
+    output.info["transparency"] = 0
+    return output
+
+
+def save_palette(path: Path, palette: list[tuple[int, int, int]]) -> None:
+    path.write_text("JASC-PAL\n0100\n16\n" + "\n".join(f"{r} {g} {b}" for r, g, b in palette) + "\n", encoding="ascii")
+
+
+def build_species(name: str, front: Image.Image, back: Image.Image, palette, shiny, icon_index: int, max_size: int) -> None:
+    destination = OUTPUT_ROOT / name
+    destination.mkdir(parents=True, exist_ok=True)
+
+    front_frame = fit(front, (64, 64), max_size)
+    front_sheet = Image.new("RGBA", (64, 128), (0, 255, 0, 0))
+    front_sheet.alpha_composite(front_frame, (0, 0))
+    front_sheet.alpha_composite(front_frame, (0, 64))
+    indexed(front_sheet, palette).save(destination / "anim_front.png", optimize=False)
+
+    back_frame = fit(back, (64, 64), max_size)
+    indexed(back_frame, palette).save(destination / "back.png", optimize=False)
+
+    icon_frame = fit(front, (32, 32), 29)
+    icon_sheet = Image.new("RGBA", (32, 64), (0, 255, 0, 0))
+    icon_sheet.alpha_composite(icon_frame, (0, 0))
+    icon_sheet.alpha_composite(icon_frame, (0, 32))
+    indexed(icon_sheet, ICON_PALETTES[icon_index]).save(destination / "icon.png", optimize=False)
+
+    south = fit(front, (32, 32), 29)
+    north = fit(back, (32, 32), 29)
+    west = fit(ImageOps.mirror(front), (32, 32), 29)
+    overworld = Image.new("RGBA", (192, 32), (0, 255, 0, 0))
+    for base_x, pose in ((0, south), (64, north), (128, west)):
+        overworld.alpha_composite(pose, (base_x, 0))
+        overworld.alpha_composite(pose, (base_x + 32, -1))
+    indexed(overworld, palette).save(destination / "overworld.png", optimize=False)
+
+    save_palette(destination / "normal.pal", palette)
+    save_palette(destination / "shiny.pal", shiny)
+    save_palette(destination / "overworld_normal.pal", palette)
+    save_palette(destination / "overworld_shiny.pal", shiny)
+    (destination / "footprint.png").write_bytes((OUTPUT_ROOT / "phycub" / "footprint.png").read_bytes())
+
+
+def main() -> None:
+    for atlas_name, names, palette, shiny, icon_index, sizes in LINES:
+        atlas = remove_checkerboard(Image.open(SOURCE_ROOT / atlas_name))
+        for row, (name, max_size) in enumerate(zip(names, sizes)):
+            build_species(name, crop_cell(atlas, 0, row), crop_cell(atlas, 1, row), palette, shiny, icon_index, max_size)
+            print(f"built {name}")
+
+
+if __name__ == "__main__":
+    main()
