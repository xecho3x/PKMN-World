@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Static release checks for PokeMan Journey v5.5 custom families."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from PIL import Image
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise SystemExit(f"v5.5 custom-family validation failed: {message}")
+
+
+species_h = read("include/constants/species.h")
+pokedex_h = read("include/constants/pokedex.h")
+species_info = read("src/data/pokemon/species_info/journey_custom.h")
+learnsets = read("src/data/pokemon/level_up_learnsets/journey_custom.h")
+abilities = read("src/data/abilities.h")
+battle_util = read("src/battle_util.c")
+moves_info = read("src/data/moves_info.h")
+starters = read("src/starter_choose.c")
+wild_source = read("src/wild_encounter.c")
+
+families = {
+    "FINRUSH": ("LUXRAY", "WATER", "LIGHTSPEED", "RIPTALON", 42),
+    "RIPTALON": ("MOTHIM_PLANT", "WATER", "LIGHTSPEED", "TSUNAMIGHT", 54),
+    "TSUNAMIGHT": ("COMBEE", "WATER, TYPE_FIGHTING", "LIGHTSPEED", None, 64),
+    "GECKORE": ("CRANIDOS", "GRASS", "STONEHEART", "CRAGUAN", 42),
+    "CRAGUAN": ("RAMPARDOS", "GRASS", "STONEHEART", "MONOLISK", 54),
+    "MONOLISK": ("SHIELDON", "GRASS, TYPE_ROCK", "STONEHEART", None, 64),
+    "KINDLET": ("BASTIODON", "FIRE", "REKINDLE", "RAPTORCH", 42),
+    "RAPTORCH": ("BURMY_PLANT", "FIRE", "REKINDLE", "PYRENIX", 54),
+    "PYRENIX": ("WORMADAM_PLANT", "FIRE, TYPE_FLYING", "REKINDLE", None, 64),
+}
+
+for name, (slot, types, ability, evolution, size) in families.items():
+    require(f"#define SPECIES_{name}" in species_h and f"SPECIES_{slot}" in species_h,
+            f"{name} species alias is missing")
+    require(f"#define NATIONAL_DEX_{name}" in pokedex_h,
+            f"{name} Pokédex alias is missing")
+    require(f"[SPECIES_{name}]" in species_info, f"{name} species info is missing")
+    block = species_info.split(f"[SPECIES_{name}]", 1)[1].split("\n},", 1)[0]
+    require(f"MON_TYPES(TYPE_{types})" in block, f"{name} type is incorrect")
+    require(f"ABILITY_{ability}" in block, f"{name} ability is incorrect")
+    require(f"MON_COORDS_SIZE({size}, {size})" in block,
+            f"{name} battle size is not {size}x{size}")
+    if evolution:
+        level = 16 if name in {"FINRUSH", "GECKORE", "KINDLET"} else 36
+        require(f"EVOLUTION({{EVO_LEVEL, {level}, SPECIES_{evolution}}})" in block,
+                f"{name} evolution is incorrect")
+
+for ability in ("LIGHTSPEED", "STONEHEART", "REKINDLE"):
+    require(f"ABILITY_{ability}" in abilities, f"{ability} ability info is missing")
+    require(f"ABILITY_{ability}" in battle_util, f"{ability} battle hook is missing")
+
+for move in ("TIDAL_BLITZ", "VERDANT_CRUSH", "PHOENIX_RUSH"):
+    require(f"[MOVE_{move}]" in moves_info, f"{move} move data is missing")
+    require(f"MOVE_{move}" in learnsets, f"{move} is absent from level-up learnsets")
+
+for name in families:
+    require(f"SPECIES_{name}" not in starters,
+            f"{name} incorrectly replaced an existing starter")
+
+require("(Random() % 100) < 15" in wild_source and "MAP_ROUTE25" in wild_source,
+        "Route 25 exact 15% Finrush selection is missing")
+
+encounters = json.loads(read("src/data/wild_encounters.json"))
+targets = {
+    "sRoute25_FireRed": ("water_mons", "SPECIES_FINRUSH", 1),
+    "sRoute25_LeafGreen": ("water_mons", "SPECIES_FINRUSH", 1),
+    "sRockTunnel1F_FireRed": ("land_mons", "SPECIES_GECKORE", 2),
+    "sRockTunnel1F_LeafGreen": ("land_mons", "SPECIES_GECKORE", 2),
+    "sMtEmberExterior_FireRed": ("land_mons", "SPECIES_KINDLET", 2),
+    "sMtEmberExterior_LeafGreen": ("land_mons", "SPECIES_KINDLET", 2),
+}
+found = {}
+for group in encounters["wild_encounter_groups"]:
+    for encounter in group.get("encounters", []):
+        label = encounter.get("base_label")
+        if label not in targets:
+            continue
+        area, species, expected = targets[label]
+        slots = [mon for mon in encounter[area]["mons"] if mon["species"] == species]
+        require(len(slots) == expected, f"{label} has {len(slots)} {species} slots, expected {expected}")
+        found[label] = True
+require(set(found) == set(targets), "one or more requested encounter maps are missing")
+
+for name in (n.lower() for n in families):
+    root = ROOT / "graphics" / "pokemon" / name
+    expected = {
+        "anim_front.png": (64, 128), "back.png": (64, 64),
+        "icon.png": (32, 64), "overworld.png": (192, 32),
+        "footprint.png": (16, 16),
+    }
+    for filename, size in expected.items():
+        path = root / filename
+        require(path.exists(), f"{name}/{filename} is missing")
+        with Image.open(path) as image:
+            require(image.size == size, f"{name}/{filename} has size {image.size}, expected {size}")
+            if filename != "footprint.png":
+                require(image.mode == "P", f"{name}/{filename} is not indexed")
+                require(max(image.getdata()) < 16, f"{name}/{filename} uses more than 16 palette indices")
+    for filename in ("normal.pal", "shiny.pal", "overworld_normal.pal", "overworld_shiny.pal"):
+        require((root / filename).exists(), f"{name}/{filename} is missing")
+
+require("TITLE        ?= POKEMAN V550" in read("Makefile"), "ROM title is not v5.5")
+require("REVISION    := 17" in read("Makefile"), "ROM revision is not 17")
+require("NEW GAME  V5.5" in read("src/main_menu.c"), "main menu version is not v5.5")
+
+print("v5.5 custom-family validation passed")
