+    for token in (
+        "FinalMewReward_ScrCheckUnlocked",
+        "FinalMewReward_ScrCreateEncounter",
+        "B_OUTCOME_CAUGHT",
+        "setflag FLAG_CAUGHT_MEW",
+        "setflag FLAG_V04_FOUGHT_MEW",
+    ):
+        require(token in faraway_mew_script, f"Final Mew reward is missing {token}")
+    final_mew_helper = read("src/final_mew_reward.c")
+    for token in (
