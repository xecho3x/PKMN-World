+	goto_if_set FLAG_JOHTO_STARTER_CHOSEN, TwoIsland_EventScript_JohtoRouteOpen
+	goto TwoIsland_EventScript_OfferJohto
+
+TwoIsland_EventScript_SailorOldText::
 	msgbox TwoIsland_Text_FellowMovedFromCeladonCity, MSGBOX_NPC
 	end
 
+TwoIsland_EventScript_OfferJohto::
+	msgbox TwoIsland_Text_JohtoPassage, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, TwoIsland_EventScript_DeclineJohto
+	setvar VAR_0x8008, 1
+	call RegionHub_EventScript_TryGiveHubPass
+	goto_if_eq VAR_RESULT, FALSE, TwoIsland_EventScript_HubPassBlocked
+	callnative RegionHub_ScrCanDepositParty
+	goto_if_eq VAR_RESULT, FALSE, TwoIsland_EventScript_JohtoNoRoom
+	setvar VAR_RESULT, 1
+	callnative RegionHub_ScrEnterRegion
+	closemessage
+	warp MAP_NEW_BARK_TOWN_PLAYERS_HOUSE_2F, 1
+	waitstate
+	releaseall
+	end
+
+TwoIsland_EventScript_DeclineJohto::
+	msgbox TwoIsland_Text_JohtoDeclined
+	releaseall
+	end
+
+TwoIsland_EventScript_JohtoNoRoom::
+	msgbox TwoIsland_Text_JohtoNoRoom
+	releaseall
+	end
+
+TwoIsland_EventScript_HubPassBlocked::
+	closemessage
+	releaseall
+	end
+
+TwoIsland_EventScript_JohtoRouteOpen::
+	msgbox TwoIsland_Text_JohtoRouteOpen
+	releaseall
+	end
+
 TwoIsland_EventScript_Woman::
 	msgbox TwoIsland_Text_ShopkeepersBrotherWorksGameCorner, MSGBOX_NPC
 	end
