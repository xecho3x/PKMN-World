diff --git a/Testing/ValidatePhycubLine.py b/Testing/ValidatePhycubLine.py
new file mode 100644
index 00000000..622fcc20
--- /dev/null
+++ b/Testing/ValidatePhycubLine.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Structural release gate for the Pokémon Journey v5.1 Phycub line."""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+
+from PIL import Image
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise AssertionError(message)
+
+
+def block(text: str, marker: str) -> str:
+    start = text.find(marker)
+    require(start >= 0, f"missing {marker}")
+    endings = [pos for token in ("\n},", "\n    },") if (pos := text.find(token, start)) >= 0]
+    require(endings, f"unterminated {marker}")
+    end = min(endings)
+    return text[start:end]
+
+
+def validate_identity_and_save_safety() -> None:
+    makefile = read("Makefile")
+    menu = read("src/main_menu.c")
+    species = read("include/constants/species.h")
+    dex = read("include/constants/pokedex.h")
+    enabled = read("include/config/species_enabled.h")
+
+    require("TITLE        ?= POKEMAN V510" in makefile, "wrong v5.1 ROM title")
+    require("REVISION    := 12" in makefile, "wrong v5.1 revision")
+    require("FILE_NAME := pokeman_journey_v510_phycub" in makefile, "wrong v5.1 filename")
+    require("NEW GAME  V5.1" in menu, "main menu does not identify v5.1")
+    require("#define SPECIES_PHYCUB       SPECIES_TURTWIG" in species, "Phycub ID alias changed")
+    require("#define SPECIES_EMBRUIN      SPECIES_GROTLE" in species, "Embruin ID alias changed")
+    require("#define SPECIES_INFERNURSA   SPECIES_TORTERRA" in species, "Infernursa ID alias changed")
+    require("SPECIES_EGG = SPECIES_CUSTOM_END" in species, "egg ID layout was altered")
+    require(re.search(r"#define P_FAMILY_TURTWIG\s+FALSE", enabled) is not None,
+            "canonical Turtwig data must remain disabled while its dormant IDs are reused")
+    require("#define NATIONAL_DEX_COUNT  NATIONAL_DEX_TORTERRA" in dex,
+            "National Dex must expose Journey entries 387-389")
+
+
+def validate_species_and_mechanics() -> None:
+    info = read("src/data/pokemon/species_info/journey_custom.h")
+    forms = read("src/data/pokemon/form_change_tables.h")
+    abilities = read("src/data/abilities.h")
+    moves = read("src/data/moves_info.h")
+    levelups = read("src/data/pokemon/level_up_learnsets/journey_custom.h")
+    battle_util = read("src/battle_util.c")
+
+    expected_stats = {
+        "PHYCUB": (50, 55, 45, 55, 55, 50),
+        "EMBRUIN": (70, 75, 65, 70, 80, 70),
+        "INFERNURSA": (90, 100, 80, 85, 115, 90),
+    }
+    fields = ("baseHP", "baseAttack", "baseDefense", "baseSpeed", "baseSpAttack", "baseSpDefense")
+    for name, stats in expected_stats.items():
+        species_block = block(info, f"[SPECIES_{name}] =")
+        require(".types = MON_TYPES(TYPE_FIRE, TYPE_DARK)" in species_block,
+                f"{name} is not Fire/Dark")
+        require("ABILITY_SOUL_SYNC" in species_block, f"{name} lacks Soul Sync")
+        require(f"NATIONAL_DEX_{name}" in species_block, f"{name} lacks unique Dex number")
+        for field, value in zip(fields, stats):
+            require(re.search(rf"\.{field}\s*=\s*{value}\b", species_block) is not None,
+                    f"{name} {field} is not {value}")
+
+    require("SPECIES_EMBRUIN, ABILITY_SOUL_SYNC, HP_LOWER_EQ_THAN, 70, 18" in forms,
+            "level-18 Embruin threshold missing")
+    require("SPECIES_INFERNURSA, ABILITY_SOUL_SYNC, HP_LOWER_EQ_THAN, 40, 36" in forms,
+            "level-36 Infernursa threshold missing")
+    require(len(re.findall(r"FORM_CHANGE_END_BATTLE,\s+SPECIES_PHYCUB", forms)) == 2,
+            "both powered forms must revert to Phycub after battle")
+    require(forms.count("FORM_CHANGE_FAINT") >= 2, "powered forms must also revert when fainting")
+    require("[ABILITY_SOUL_SYNC]" in abilities and "Battle stress unlocks stronger forms." in abilities,
+            "Soul Sync ability data missing")
+    soul_pyre = block(moves, "[MOVE_SOUL_PYRE] =")
+    for expected in (".power = 90", ".type = TYPE_FIRE", ".accuracy = 100", ".chance = 20"):
+        require(expected in soul_pyre, f"Soul Pyre missing {expected}")
+    require("LEVEL_UP_MOVE(18, MOVE_FLAME_WHEEL)" in levelups, "mid-form power move missing")
+    require("LEVEL_UP_MOVE(36, MOVE_SOUL_PYRE)" in levelups, "final-form signature move missing")
+    require("targetSpecies == SPECIES_EMBRUIN || targetSpecies == SPECIES_INFERNURSA" in battle_util,
+            "temporary evolutions are not registered in the Pokédex")
+
+
+def validate_obtainability_and_dex_order() -> None:
+    encounters = json.loads(read("src/data/wild_encounters.json"))
+    slot_weights = (20, 20, 10, 10, 10, 10, 5, 5, 4, 4, 1, 1)
+    mt_moon_tables = []
+    for group in encounters["wild_encounter_groups"]:
+        for encounter in group["encounters"]:
+            if encounter.get("map") == "MAP_MT_MOON_1F" and "land_mons" in encounter:
+                mt_moon_tables.append(encounter)
+
+    require({table["base_label"] for table in mt_moon_tables}
+            == {"sMtMoon1F_FireRed", "sMtMoon1F_LeafGreen"},
+            "Phycub must be configured for both Mt. Moon version tables")
+    for table in mt_moon_tables:
+        mons = table["land_mons"]["mons"]
+        phycub_rate = sum(weight for weight, mon in zip(slot_weights, mons)
+                          if mon["species"] == "SPECIES_PHYCUB")
+        require(phycub_rate == 80,
+                f"{table['base_label']} Phycub rate is {phycub_rate}%, expected 80%")
+        require(all(mon["min_level"] == 9 and mon["max_level"] == 10
+                    for mon in mons if mon["species"] == "SPECIES_PHYCUB"),
+                f"{table['base_label']} Phycub levels must remain 9-10")
+
+    orders = read("src/data/pokemon/pokedex_orders.h")
+    for name in ("PHYCUB", "EMBRUIN", "INFERNURSA"):
+        require(orders.count(f"NATIONAL_DEX_{name}") == 3,
+                f"{name} must occur once in alphabetical, weight, and height order")
+    for old in ("TURTWIG", "GROTLE", "TORTERRA"):
+        require(f"NATIONAL_DEX_{old}" not in orders,
+                f"disabled {old} remains in a Journey Dex order")
+
+
+def validate_art() -> None:
+    expected = {
+        "anim_front.png": (64, 128),
+        "back.png": (64, 64),
+        "icon.png": (32, 64),
+        "footprint.png": (16, 16),
+        "overworld.png": (192, 32),
+    }
+    for name in ("phycub", "embruin", "infernursa"):
+        folder = ROOT / "graphics" / "pokemon" / name
+        for filename, size in expected.items():
+            path = folder / filename
+            require(path.is_file(), f"missing {path.relative_to(ROOT)}")
+            image = Image.open(path)
+            require(image.size == size, f"{path.relative_to(ROOT)} is {image.size}, expected {size}")
+            require(image.mode == "P", f"{path.relative_to(ROOT)} must be indexed")
+            used = set(image.getdata())
+            require(max(used, default=0) < 16, f"{path.relative_to(ROOT)} uses more than 16 colors")
+        for filename in ("normal.pal", "shiny.pal", "overworld_normal.pal", "overworld_shiny.pal"):
+            lines = (folder / filename).read_text(encoding="ascii").splitlines()
+            require(lines[:3] == ["JASC-PAL", "0100", "16"], f"invalid palette {filename} for {name}")
+            require(len(lines) == 19, f"{filename} for {name} must contain exactly 16 colors")
+
+
+def main() -> None:
+    validate_identity_and_save_safety()
+    validate_species_and_mechanics()
+    validate_obtainability_and_dex_order()
+    validate_art()
+    print("Phycub v5.1 validation passed: 3 species, 2 battle transformations, 1 signature move, complete GBA art")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Testing/ValidateRegional386.py b/Testing/ValidateRegional386.py
new file mode 100644
index 00000000..29919012
--- /dev/null
+++ b/Testing/ValidateRegional386.py
@@ -0,0 +1,801 @@
+#!/usr/bin/env python3
+"""Validate one-save, no-trade acquisition of the canonical Gen 1-3 Pokédex.
+
+Run from anywhere:
+
+    python Testing/ValidateRegional386.py
+
+This is a source-level release gate.  It mirrors the merged Emerald build's active
+wild-table rule (FireRed tables compile under EMERALD; LeafGreen duplicates do not),
+then follows direct encounters through breeding and offline evolutions.  It requires:
+
+* all 100 Johto species to have a Johto path;
+* all 135 Hoenn species to have a Hoenn path;
+* every one of the 386 species to have a path somewhere in the three-region game;
+* no link trade as part of a proof;
+* evolution items used by a proof to be obtainable in that region;
+* event tickets and their matching ferry-enable flags to be granted in normal play;
+* the paired Hoenn Lati roamer/Southern Island route and both Johto beast roamers;
+* special sources such as Feebas and TV mass outbreaks.
+
+The validator deliberately does not count Battle Pike/Pyramid facility parties,
+trainer parties, debug gifts, in-game trades, Mystery Gift scripts, or LeafGreen-only
+encounter duplicates as acquisition paths.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+REGIONS = ("REGION_KANTO", "REGION_JOHTO", "REGION_HOENN")
+REGION_LABEL = {
+    "REGION_KANTO": "Kanto",
+    "REGION_JOHTO": "Johto",
+    "REGION_HOENN": "Hoenn",
+}
+
+SCRIPT_MON_COMMAND = re.compile(
+    r"\b(?:givemon|giveegg|setwildbattle|seteventmon|givenamedmon|giveoddegg)"
+    r"\s+(SPECIES_[A-Z0-9_]+)\b"
+)
+SCRIPT_DYNAMIC_MON_COMMAND = re.compile(
+    r"\b(?:givemon|giveegg|setwildbattle|seteventmon|givenamedmon|giveoddegg)"
+    r"\s+([A-Z][A-Z0-9_x]+)\b"
+)
+ITEM_SOURCE_COMMAND = re.compile(
+    r"\b(?:giveitem|giveitem_msg|additem|finditem)\s+(ITEM_[A-Z0-9_]+)\b"
+)
+ITEM_SHOP_ENTRY = re.compile(r"^\s*\.2byte\s+(ITEM_[A-Z0-9_]+)\b", re.MULTILINE)
+
+
+class ValidationError(Exception):
+    pass
+
+
+def read(relative: str | Path) -> str:
+    return (ROOT / relative).read_text(encoding="utf-8", errors="replace")
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise ValidationError(message)
+
+
+def matching_block(text: str, open_pos: int, opener: str = "{", closer: str = "}") -> str:
+    """Return a balanced block including its delimiters."""
+    require(open_pos < len(text) and text[open_pos] == opener, "balanced-block parser lost its opener")
+    depth = 0
+    for pos in range(open_pos, len(text)):
+        if text[pos] == opener:
+            depth += 1
+        elif text[pos] == closer:
+            depth -= 1
+            if depth == 0:
+                return text[open_pos : pos + 1]
+    raise ValidationError(f"unbalanced {opener}{closer} block")
+
+
+def function_block(text: str, function_name: str) -> str:
+    match = re.search(rf"\b{re.escape(function_name)}\s*\([^;]*?\)\s*\{{", text, re.DOTALL)
+    require(match is not None, f"could not find function {function_name}")
+    brace = text.find("{", match.start())
+    return matching_block(text, brace)
+
+
+def canonical_species() -> list[str]:
+    pokedex = read("include/constants/pokedex.h")
+    section = pokedex.split("enum NationalDexOrder", 1)[1]
+    section = section.split("// Sinnoh", 1)[0]
+    names = re.findall(r"^\s*NATIONAL_DEX_([A-Z0-9_]+),", section, re.MULTILINE)
+    names = [name for name in names if name != "NONE"]
+    require(len(names) == 386, f"expected 386 canonical Gen 1-3 Pokédex entries, parsed {len(names)}")
+    require(names[0] == "BULBASAUR" and names[-1] == "DEOXYS", "canonical Pokédex bounds drifted")
+    return names
+
+
+CANONICAL = canonical_species()
+CANONICAL_SET = set(CANONICAL)
+DEX_NUMBER = {name: number for number, name in enumerate(CANONICAL, 1)}
+
+# The species enum exposes form-explicit constants for these two base species.
+SPECIES_TOKEN_ALIAS = {
+    "CASTFORM_NORMAL": "CASTFORM",
+    "CASTFORM": "CASTFORM",
+    "DEOXYS_NORMAL": "DEOXYS",
+    "DEOXYS": "DEOXYS",
+}
+
+
+def species_name(token: str) -> str | None:
+    name = token.removeprefix("SPECIES_")
+    name = SPECIES_TOKEN_ALIAS.get(name, name)
+    return name if name in CANONICAL_SET else None
+
+
+def load_map_regions() -> tuple[dict[str, str], dict[Path, str], dict[str, str]]:
+    groups = json.loads(read("data/maps/map_groups.json"))
+    group_order = groups["group_order"]
+    name_to_group = {
+        map_name: group_name
+        for group_name in group_order
+        for map_name in groups.get(group_name, [])
+    }
+    johto_start = group_order.index("gMapGroup_JohtoTownsAndRoutes")
+    johto_end = group_order.index("gMapGroup_RegionHub")
+    johto_groups = set(group_order[johto_start:johto_end])
+
+    by_map_id: dict[str, str] = {}
+    by_directory: dict[Path, str] = {}
+    map_group_by_id: dict[str, str] = {}
+    for map_json in sorted((ROOT / "data/maps").glob("*/map.json")):
+        data = json.loads(map_json.read_text(encoding="utf-8", errors="replace"))
+        map_id = data.get("id")
+        require(map_id, f"{map_json.relative_to(ROOT)} has no map id")
+        group = name_to_group.get(data.get("name"))
+        region = data.get("region")
+        # A late block of imported Johto maps predates the per-map region field.  Their
+        # position in map_groups.json is authoritative in the merged build.
+        if region is None and group in johto_groups:
+            region = "REGION_JOHTO"
+        if region in REGIONS:
+            by_map_id[map_id] = region
+            by_directory[map_json.parent] = region
+        if group:
+            map_group_by_id[map_id] = group
+
+    for region in REGIONS:
+        require(region in by_map_id.values(), f"no maps classified for {REGION_LABEL[region]}")
+    return by_map_id, by_directory, map_group_by_id
+
+
+MAP_REGION, DIRECTORY_REGION, MAP_GROUP = load_map_regions()
+
+
+def load_item_aliases() -> dict[str, str]:
+    aliases = {}
+    for left, right in re.findall(
+        r"^\s*(ITEM_[A-Z0-9_]+)\s*=\s*(ITEM_[A-Z0-9_]+)\s*,",
+        read("include/constants/items.h"),
+        re.MULTILINE,
+    ):
+        aliases[left] = right
+    return aliases
+
+
+ITEM_ALIASES = load_item_aliases()
+
+
+def normalize_item(item: str) -> str:
+    seen = set()
+    while item in ITEM_ALIASES and item not in seen:
+        seen.add(item)
+        item = ITEM_ALIASES[item]
+    return item
+
+
+def event_gate_for_map(map_id: str) -> tuple[str, str] | None:
+    definitions = (
+        ("SOUTHERN_ISLAND", "ITEM_EON_TICKET", "FLAG_ENABLE_SHIP_SOUTHERN_ISLAND"),
+        ("NAVEL_ROCK", "ITEM_MYSTIC_TICKET", "FLAG_ENABLE_SHIP_NAVEL_ROCK"),
+        ("BIRTH_ISLAND", "ITEM_AURORA_TICKET", "FLAG_ENABLE_SHIP_BIRTH_ISLAND"),
+        ("FARAWAY_ISLAND", "ITEM_OLD_SEA_MAP", "FLAG_ENABLE_SHIP_FARAWAY_ISLAND"),
+    )
+    for fragment, item, flag in definitions:
+        if fragment in map_id:
+            return item, flag
+    return None
+
+
+def all_map_scripts() -> list[tuple[str, str, Path, str]]:
+    result = []
+    for directory, region in sorted(DIRECTORY_REGION.items(), key=lambda pair: str(pair[0])):
+        map_json = json.loads((directory / "map.json").read_text(encoding="utf-8", errors="replace"))
+        script_path = directory / "scripts.inc"
+        if script_path.exists():
+            result.append(
+                (
+                    map_json["id"],
+                    region,
+                    script_path,
+                    script_path.read_text(encoding="utf-8", errors="replace"),
+                )
+            )
+    return result
+
+
+MAP_SCRIPTS = all_map_scripts()
+
+
+def audit_event_tickets() -> tuple[dict[str, bool], list[str]]:
+    """Prove tickets come from normal map scripts, not Mystery Gift stubs."""
+    definitions = {
+        "ITEM_EON_TICKET": "FLAG_ENABLE_SHIP_SOUTHERN_ISLAND",
+        "ITEM_MYSTIC_TICKET": "FLAG_ENABLE_SHIP_NAVEL_ROCK",
+        "ITEM_AURORA_TICKET": "FLAG_ENABLE_SHIP_BIRTH_ISLAND",
+        "ITEM_OLD_SEA_MAP": "FLAG_ENABLE_SHIP_FARAWAY_ISLAND",
+    }
+    passed = {}
+    details = []
+    for item, flag in definitions.items():
+        grant_files = []
+        transport_files = []
+        for map_id, _region, path, text in MAP_SCRIPTS:
+            # Do not let an item found on its own gated island prove access to that island.
+            if event_gate_for_map(map_id) is None:
+                grants_item = bool(
+                    re.search(rf"\b(?:giveitem|giveitem_msg|additem)\s+{item}\b", text)
+                )
+                if grants_item and re.search(rf"\bsetflag\s+{flag}\b", text):
+                    grant_files.append(path.relative_to(ROOT).as_posix())
+            if re.search(rf"\bcheckitem\s+{item}\b", text) and flag in text:
+                transport_files.append(path.relative_to(ROOT).as_posix())
+        passed[item] = bool(grant_files and transport_files)
+        if passed[item]:
+            details.append(
+                f"{item}: grant+enable in {grant_files[0]}; ferry gate in {transport_files[0]}"
+            )
+        else:
+            missing = []
+            if not grant_files:
+                missing.append(f"a normal-play giveitem plus setflag {flag}")
+            if not transport_files:
+                missing.append("a ferry/harbor check for both item and enable flag")
+            details.append(f"{item}: MISSING " + " and ".join(missing))
+    return passed, details
+
+
+TICKET_ACCESS, TICKET_DETAILS = audit_event_tickets()
+
+
+def collect_item_sources() -> dict[str, set[str]]:
+    items = {region: set() for region in REGIONS}
+    for map_id, region, _path, text in MAP_SCRIPTS:
+        gate = event_gate_for_map(map_id)
+        if gate and not TICKET_ACCESS.get(gate[0], False):
+            continue
+        found = set(ITEM_SOURCE_COMMAND.findall(text)) | set(ITEM_SHOP_ENTRY.findall(text))
+
+        # Handle scripts that select an item in a variable before a generic giveitem.
+        for variable in set(re.findall(r"\bgiveitem\s+([A-Z][A-Z0-9_x]+)\b", text)):
+            found.update(
+                re.findall(rf"\bsetvar\s+{re.escape(variable)},\s*(ITEM_[A-Z0-9_]+)\b", text)
+            )
+        items[region].update(normalize_item(item) for item in found)
+    return items
+
+
+ITEMS_BY_REGION = collect_item_sources()
+
+
+Sources = dict[str, dict[str, list[str]]]
+
+
+def new_sources() -> Sources:
+    return {region: defaultdict(list) for region in REGIONS}
+
+
+def add_source(sources: Sources, region: str, token: str, reason: str) -> None:
+    name = species_name(token)
+    if region in REGIONS and name is not None and reason not in sources[region][name]:
+        sources[region][name].append(reason)
+
+
+def collect_wild_sources(sources: Sources) -> tuple[int, int, list[str]]:
+    generator = read("tools/wild_encounters/wild_encounters_to_header.py")
+    require(
+        'if "LeafGreen" in shared_label:' in generator
+        and 'version = "LEAFGREEN"' in generator,
+        "wild-table version rule changed; update this validator before trusting its active-table scan",
+    )
+    wild = json.loads(read("src/data/wild_encounters.json"))
+    active_entries = 0
+    facility_entries = 0
+    unresolved_maps = []
+    for group in wild.get("wild_encounter_groups", []):
+        label = group.get("label")
+        if label != "gWildMonHeaders":
+            facility_entries += sum(
+                len(table.get("mons", []))
+                for encounter in group.get("encounters", [])
+                for key, table in encounter.items()
+                if key.endswith("_mons") and isinstance(table, dict)
+            )
+            continue
+        for encounter in group.get("encounters", []):
+            # tools/wild_encounters/wild_encounters_to_header.py emits LeafGreen
+            # duplicate headers under #ifdef LEAFGREEN.  The unified ROM is EMERALD.
+            if "LeafGreen" in encounter.get("base_label", ""):
+                continue
+            map_id = encounter.get("map")
+            if not map_id:
+                continue
+            region = MAP_REGION.get(map_id)
+            if region is None:
+                unresolved_maps.append(map_id)
+                continue
+            for field, table in encounter.items():
+                if not field.endswith("_mons") or not isinstance(table, dict):
+                    continue
+                for mon in table.get("mons", []):
+                    token = mon.get("species", "")
+                    active_entries += 1
+                    add_source(sources, region, token, f"wild {map_id}/{field}")
+    return active_entries, facility_entries, sorted(set(unresolved_maps))
+
+
+def collect_script_sources(sources: Sources) -> int:
+    count = 0
+    for map_id, region, path, text in MAP_SCRIPTS:
+        gate = event_gate_for_map(map_id)
+        if gate and not TICKET_ACCESS.get(gate[0], False):
+            continue
+
+        # Latias/Latios are mutually exclusive in Southern Island's script.  They are
+        # added later only after the roamer + complementary-island pairing is proved.
+        southern_lati = "SOUTHERN_ISLAND" in map_id
+        for token in SCRIPT_MON_COMMAND.findall(text):
+            if southern_lati and species_name(token) in {"LATIAS", "LATIOS"}:
+                continue
+            add_source(sources, region, token, f"script {path.relative_to(ROOT).as_posix()}")
+            count += 1
+
+        # Follow simple script variables used by fossil/starter-reward style gifts.
+        for variable in set(SCRIPT_DYNAMIC_MON_COMMAND.findall(text)):
+            if variable.startswith("SPECIES_"):
+                continue
+            assigned = re.findall(
+                rf"\bsetvar\s+{re.escape(variable)},\s*(SPECIES_[A-Z0-9_]+)\b", text
+            )
+            for token in assigned:
+                add_source(
+                    sources,
+                    region,
+                    token,
+                    f"script variable {variable} in {path.relative_to(ROOT).as_posix()}",
+                )
+                count += 1
+    return count
+
+
+def starter_tables() -> dict[str, list[str]]:
+    text = read("src/starter_choose.c")
+    result = {}
+    for region, body in re.findall(
+        r"\[(REGION_(?:KANTO|JOHTO|HOENN))\]\s*=\s*\{([^}]*)\}", text
+    ):
+        species = [
+            species_name(token)
+            for token in re.findall(r"SPECIES_[A-Z0-9_]+", body)
+        ]
+        result[region] = [name for name in species if name]
+    return result
+
+
+def add_and_audit_starters(sources: Sources) -> list[str]:
+    tables = starter_tables()
+    details = []
+    for region in REGIONS:
+        trio = tables.get(region, [])
+        require(len(trio) == 3, f"{REGION_LABEL[region]} starter table does not contain 3 canonical species")
+
+        reward_flags = set()
+        reward_species = set()
+        reward_files = []
+        has_selection = False
+        for map_id, script_region, path, text in MAP_SCRIPTS:
+            if script_region != region:
+                continue
+            if "givemon PLAYER_STARTER_SPECIES" in text or (
+                region == "REGION_HOENN" and "special ChooseStarter" in text
+            ):
+                has_selection = True
+            if re.search(r"\bgivemon\s+VAR_0x8004\b", text) and "STARTER" in text:
+                reward_files.append(path.relative_to(ROOT).as_posix())
+                reward_flags.update(re.findall(r"FLAG_[A-Z0-9_]*STARTER[A-Z0-9_]*", text))
+                reward_species.update(
+                    filter(
+                        None,
+                        (
+                            species_name(token)
+                            for token in re.findall(
+                                r"\bsetvar\s+VAR_0x8004,\s*(SPECIES_[A-Z0-9_]+)\b", text
+                            )
+                        ),
+                    )
+                )
+
+        require(has_selection, f"{REGION_LABEL[region]} has a starter table but no reachable selection script")
+        require(
+            len(reward_flags) >= 2,
+            f"{REGION_LABEL[region]} needs two separately flagged unchosen-starter rewards; "
+            f"found {sorted(reward_flags)}",
+        )
+        require(
+            set(trio) <= reward_species,
+            f"{REGION_LABEL[region]} reward branches do not cover its whole trio; "
+            f"trio={trio}, branches={sorted(reward_species)}",
+        )
+        for name in trio:
+            add_source(
+                sources,
+                region,
+                "SPECIES_" + name,
+                "regional starter selection plus two unchosen-starter rewards",
+            )
+        details.append(
+            f"{REGION_LABEL[region]} trio {', '.join(trio)}; "
+            f"{len(reward_flags)} reward flags across {len(reward_files)} scripts"
+        )
+    return details
+
+
+def collect_special_sources(sources: Sources) -> list[str]:
+    details = []
+
+    wild_c = read("src/wild_encounter.c")
+    feebas = re.search(
+        r"\bgWildFeebas\s*=\s*\{[^}]*?(SPECIES_FEEBAS)\s*\}", wild_c, re.DOTALL
+    )
+    feebas_map = re.search(
+        r"\{\s*SPECIES_FEEBAS,\s*MAP_GROUP\((MAP_[A-Z0-9_]+)\)",
+        read("src/pokedex_area_screen.c"),
+    )
+    require(feebas is not None and feebas_map is not None, "Feebas special encounter wiring is missing")
+    map_id = feebas_map.group(1)
+    region = MAP_REGION.get(map_id)
+    require(region is not None, f"Feebas special map {map_id} has no region")
+    add_source(sources, region, feebas.group(1), f"special Feebas tiles on {map_id}")
+    details.append(f"Feebas special tiles: {map_id}")
+
+    tv = read("src/tv.c")
+    start = tv.find("sPokeOutbreakSpeciesList[]")
+    require(start >= 0, "mass-outbreak species table is missing")
+    open_brace = tv.find("{", start)
+    outbreak_block = matching_block(tv, open_brace)
+    outbreaks = re.findall(
+        r"\.species\s*=\s*(SPECIES_[A-Z0-9_]+).*?"
+        r"\.location\s*=\s*MAP_NUM\((MAP_[A-Z0-9_]+)\)",
+        outbreak_block,
+        re.DOTALL,
+    )
+    require(outbreaks, "mass-outbreak table parsed no species/map pairs")
+    for token, outbreak_map in outbreaks:
+        outbreak_region = MAP_REGION.get(outbreak_map)
+        require(outbreak_region is not None, f"outbreak map {outbreak_map} has no region")
+        add_source(sources, outbreak_region, token, f"TV mass outbreak on {outbreak_map}")
+    details.append(f"TV mass outbreaks: {len(outbreaks)} species/map entries")
+    return details
+
+
+def collect_roamer_sources(sources: Sources) -> list[str]:
+    details = []
+    roamer = read("src/roamer.c")
+    globals_h = read("include/constants/global.h")
+    count_match = re.search(r"#define\s+ROAMER_COUNT\s+(\d+)", globals_h)
+    require(count_match is not None, "ROAMER_COUNT is not a numeric constant")
+    roamer_count = int(count_match.group(1))
+
+    beasts = function_block(roamer, "InitJohtoBeastRoamers")
+    beast_species = {
+        species_name(token)
+        for token in re.findall(r"TryAddRoamer\((SPECIES_[A-Z0-9_]+)", beasts)
+    }
+    beast_species.discard(None)
+    require(
+        {"ENTEI", "RAIKOU"} <= beast_species,
+        f"Johto's simultaneous beast release is incomplete: {sorted(beast_species)}",
+    )
+    require(roamer_count >= 2, f"ROAMER_COUNT={roamer_count}; Entei and Raikou cannot coexist")
+    for name in ("ENTEI", "RAIKOU"):
+        add_source(sources, "REGION_JOHTO", "SPECIES_" + name, "simultaneous Johto beast roamers")
+    details.append(f"Johto roamers: Entei + Raikou with ROAMER_COUNT={roamer_count}")
+
+    init_lati = function_block(roamer, "InitRoamer")
+    lati_roamers = {
+        species_name(token)
+        for token in re.findall(r"SPECIES_(?:LATIAS|LATIOS)", init_lati)
+    }
+    lati_roamers.discard(None)
+    southern = next(
+        (text for map_id, _region, _path, text in MAP_SCRIPTS if map_id == "MAP_SOUTHERN_ISLAND_INTERIOR"),
+        "",
+    )
+    southern_species = {
+        species_name(token)
+        for token in re.findall(r"seteventmon\s+(SPECIES_(?:LATIAS|LATIOS))", southern)
+    }
+    southern_species.discard(None)
+    require(
+        lati_roamers == {"LATIAS", "LATIOS"},
+        f"Hoenn roamer choice does not cover both Lati species: {sorted(lati_roamers)}",
+    )
+    require(
+        southern_species == {"LATIAS", "LATIOS"},
+        f"Southern Island does not provide the complementary Lati: {sorted(southern_species)}",
+    )
+    require(TICKET_ACCESS["ITEM_EON_TICKET"], "paired Lati path exists but Eon Ticket access failed")
+    for name in ("LATIAS", "LATIOS"):
+        add_source(
+            sources,
+            "REGION_HOENN",
+            "SPECIES_" + name,
+            "one Hoenn roamer plus the complementary Southern Island encounter",
+        )
+    details.append("Hoenn roamers: one Lati choice + complementary Eon Ticket encounter")
+    return details
+
+
+def species_blocks() -> dict[str, str]:
+    result = {}
+    for gen in (1, 2, 3):
+        text = read(f"src/data/pokemon/species_info/gen_{gen}_families.h")
+        headers = list(
+            re.finditer(r"^\s*\[(SPECIES_[A-Z0-9_]+)\]\s*=", text, re.MULTILINE)
+        )
+        for index, header in enumerate(headers):
+            name = species_name(header.group(1))
+            if name is None:
+                continue
+            end = headers[index + 1].start() if index + 1 < len(headers) else len(text)
+            # Prefer the first base-form block when aliases/forms map to one dex species.
+            result.setdefault(name, text[header.end() : end])
+    require(len(result) == 386, f"expected 386 canonical species-info blocks, parsed {len(result)}")
+    return result
+
+
+SPECIES_BLOCKS = species_blocks()
+
+
+def evolution_edges() -> dict[str, list[tuple[str, str, tuple[str, ...], str]]]:
+    """source -> (target, method, required_items, source_record)."""
+    result = defaultdict(list)
+    for source, block in SPECIES_BLOCKS.items():
+        marker = ".evolutions = EVOLUTION("
+        pos = block.find(marker)
+        if pos < 0:
+            continue
+        open_paren = pos + len(marker) - 1
+        evo_macro = matching_block(block, open_paren, "(", ")")
+        cursor = 0
+        while cursor < len(evo_macro):
+            brace = evo_macro.find("{", cursor)
+            if brace < 0:
+                break
+            record = matching_block(evo_macro, brace)
+            cursor = brace + len(record)
+            head = re.match(
+                r"\{\s*(EVO_[A-Z0-9_]+)\s*,\s*([^,{}]+)\s*,\s*(SPECIES_[A-Z0-9_]+)",
+                record,
+            )
+            if not head:
+                continue
+            method, parameter, target_token = head.groups()
+            target = species_name(target_token)
+            if target is None:
+                continue
+            items = set(
+                normalize_item(item)
+                for item in re.findall(r"\bITEM_[A-Z0-9_]+\b", record)
+            )
+            if method == "EVO_ITEM" and parameter.strip().startswith("ITEM_"):
+                items.add(normalize_item(parameter.strip()))
+            result[source].append((target, method, tuple(sorted(items)), record))
+    require(sum(map(len, result.values())) >= 200, "evolution parser produced too few Gen 1-3 edges")
+    return result
+
+
+EVOLUTION_EDGES = evolution_edges()
+
+
+def is_breedable(name: str) -> bool:
+    block = SPECIES_BLOCKS[name]
+    egg_groups = re.search(r"\.eggGroups\s*=\s*MON_EGG_GROUPS\(([^)]*)\)", block)
+    require(egg_groups is not None, f"{name} species data has no egg-group declaration")
+    return "EGG_GROUP_UNDISCOVERED" not in egg_groups.group(1)
+
+
+def daycare_regions() -> dict[str, list[str]]:
+    require(
+        re.search(
+            r"^#define\s+P_INCENSE_BREEDING\s+GEN_LATEST\b",
+            read("include/config/pokemon.h"),
+            re.MULTILINE,
+        )
+        is not None,
+        "breeding proof assumes the configured Gen 9 rule where baby species need no incense",
+    )
+    found = {region: [] for region in REGIONS}
+    for _map_id, region, path, text in MAP_SCRIPTS:
+        if re.search(r"\bDAYCARE_(?:EGG|ONE_MON|TWO_MONS)\b|DayCare_", text):
+            found[region].append(path.relative_to(ROOT).as_posix())
+    for region in REGIONS:
+        require(found[region], f"{REGION_LABEL[region]} has no usable breeding/day-care script")
+    return found
+
+
+DAYCARES = daycare_regions()
+
+
+def edge_is_offline(
+    edge: tuple[str, str, tuple[str, ...], str], region: str
+) -> tuple[bool, tuple[str, ...]]:
+    _target, method, required_items, _record = edge
+    if method == "EVO_TRADE":
+        return False, ()
+    missing_items = tuple(
+        item for item in required_items if item not in ITEMS_BY_REGION[region]
+    )
+    return not missing_items, missing_items
+
+
+def reachable_in_region(
+    sources: Sources, region: str
+) -> tuple[set[str], dict[str, str], dict[str, set[str]]]:
+    reachable = set(sources[region])
+    proof = {
+        name: sources[region][name][0]
+        for name in reachable
+        if sources[region][name]
+    }
+    blocked_items: dict[str, set[str]] = defaultdict(set)
+    changed = True
+    while changed:
+        changed = False
+        for source, edges in EVOLUTION_EDGES.items():
+            for edge in edges:
+                target, method, _items, _record = edge
+                if source in reachable and target not in reachable:
+                    allowed, missing = edge_is_offline(edge, region)
+                    if allowed:
+                        reachable.add(target)
+                        proof[target] = f"offline {method} from {source}"
+                        changed = True
+                    else:
+                        blocked_items[target].update(missing or {"LINK_TRADE"})
+
+                # A caught breedable evolved form can produce its family's base form.
+                # Repeated closure then evolves that offspring back through intermediate
+                # stages, matching actual daycare behavior without pretending legends breed.
+                if target in reachable and source not in reachable and is_breedable(target):
+                    reachable.add(source)
+                    proof[source] = f"breed from the {target} family at {DAYCARES[region][0]}"
+                    changed = True
+    return reachable, proof, blocked_items
+
+
+def audit_area_lookup() -> str:
+    area = read("src/pokedex_area_screen.c")
+    require(
+        "SetMapHasMon(" in area and "RegionMapHasSection(" in area,
+        "Pokédex area lookup lacks the merged-map-group fallback",
+    )
+    wild = json.loads(read("src/data/wild_encounters.json"))
+    staryu_maps = {"REGION_KANTO": [], "REGION_JOHTO": []}
+    for group in wild["wild_encounter_groups"]:
+        if group.get("label") != "gWildMonHeaders":
+            continue
+        for encounter in group.get("encounters", []):
+            region = MAP_REGION.get(encounter.get("map"))
+            if region not in staryu_maps or "LeafGreen" in encounter.get("base_label", ""):
+                continue
+            if any(
+                species_name(mon.get("species", "")) == "STARYU"
+                for key, table in encounter.items()
+                if key.endswith("_mons") and isinstance(table, dict)
+                for mon in table.get("mons", [])
+            ):
+                staryu_maps[region].append(encounter["map"])
+    for region, maps in staryu_maps.items():
+        require(maps, f"no active {REGION_LABEL[region]} Staryu encounter remains to exercise the area lookup")
+    return "Staryu area sources: " + "; ".join(
+        f"{REGION_LABEL[region]} " + ", ".join(sorted(set(maps)))
+        for region, maps in staryu_maps.items()
+    )
+
+
+def main() -> int:
+    sources = new_sources()
+    active_wild, facility_wild, unresolved_maps = collect_wild_sources(sources)
+    require(not unresolved_maps, "wild encounter maps lack region metadata: " + ", ".join(unresolved_maps))
+    script_count = collect_script_sources(sources)
+    starter_details = add_and_audit_starters(sources)
+    special_details = collect_special_sources(sources)
+    roamer_details = collect_roamer_sources(sources)
+    area_detail = audit_area_lookup()
+
+    print("Regional 386 acquisition audit")
+    print(
+        f"  canonical species: {len(CANONICAL)} | active wild slots: {active_wild} | "
+        f"scripted direct references: {script_count}"
+    )
+    print(
+        f"  excluded facility-only wild slots: {facility_wild} "
+        "(Battle Pike/Pyramid are not acquisition paths)"
+    )
+    print(f"  {area_detail}")
+    for detail in TICKET_DETAILS:
+        print(f"  ticket: {detail}")
+    for detail in starter_details + special_details + roamer_details:
+        print(f"  {detail}")
+
+    required = {
+        "REGION_KANTO": set(CANONICAL[:151]),
+        "REGION_JOHTO": set(CANONICAL[151:251]),
+        "REGION_HOENN": set(CANONICAL[251:386]),
+    }
+    reachable = {}
+    blocked = {}
+    for region in REGIONS:
+        reachable[region], _proof, blocked[region] = reachable_in_region(sources, region)
+        native_count = len(required[region] & reachable[region])
+        print(
+            f"  {REGION_LABEL[region]}: {len(sources[region])} direct species, "
+            f"{len(reachable[region])} after breeding/offline evolution, "
+            f"{native_count}/{len(required[region])} native Pokédex"
+        )
+
+    failures = []
+    for item, ok in TICKET_ACCESS.items():
+        if not ok:
+            failures.append(f"{item} cannot be obtained and used without Mystery Gift")
+
+    # Mew is intentionally the unique cross-region, all-24-badge final reward.
+    # Every other Kanto species must have a Kanto-local path, while every Gen 2
+    # and Gen 3 species must have one in Johto and Hoenn respectively.
+    native_required = dict(required)
+    native_required["REGION_KANTO"] = required["REGION_KANTO"] - {"MEW"}
+    for region in REGIONS:
+        missing = sorted(native_required[region] - reachable[region], key=DEX_NUMBER.get)
+        if not missing:
+            continue
+        failures.append(
+            f"{REGION_LABEL[region]} is missing {len(missing)} native species: "
+            + ", ".join(f"#{DEX_NUMBER[name]} {name}" for name in missing)
+        )
+        for name in missing:
+            hints = sorted(blocked[region].get(name, ()))
+            if hints:
+                failures.append(
+                    f"  {REGION_LABEL[region]} #{DEX_NUMBER[name]} {name}: "
+                    f"blocked evolution requirement(s): {', '.join(hints)}"
+                )
+            else:
+                failures.append(
+                    f"  {REGION_LABEL[region]} #{DEX_NUMBER[name]} {name}: "
+                    "add a direct native-region encounter/gift or a breedable family source"
+                )
+
+    all_reachable = set().union(*(reachable[region] for region in REGIONS))
+    missing_anywhere = sorted(CANONICAL_SET - all_reachable, key=DEX_NUMBER.get)
+    if missing_anywhere:
+        failures.append(
+            "Not obtainable anywhere in one save: "
+            + ", ".join(f"#{DEX_NUMBER[name]} {name}" for name in missing_anywhere)
+        )
+
+    if failures:
+        print("\nFAIL — regional acquisition requirements are incomplete:")
+        for failure in failures:
+            print(f"  {failure}")
+        return 1
+
+    print(
+        "\nOK — all 386 canonical Gen 1-3 Pokémon have one-save, no-link-trade paths; "
+        "Gen 2 is complete in Johto and Gen 3 is complete in Hoenn."
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (OSError, json.JSONDecodeError, ValidationError) as error:
+        print(f"FAIL — validator could not complete: {error}")
+        sys.exit(1)
