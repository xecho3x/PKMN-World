diff --git a/src/final_mew_reward.c b/src/final_mew_reward.c
new file mode 100644
index 0000000000000000000000000000000000000000..02374e96cef176b722dc1ff0fd33016fbea7e9db
--- /dev/null
+++ b/src/final_mew_reward.c
@@ -0,0 +1,75 @@
+#include "global.h"
+#include "event_data.h"
+#include "pokedex.h"
+#include "pokemon.h"
+#include "script.h"
+#include "constants/regions.h"
+
+// The final mythical reward belongs to the complete three-region gym tour,
+// not to any one region's champion flag. This deliberately checks every
+// region's independent badge bank so skipped gyms cannot unlock it early.
+void FinalMewReward_ScrCheckUnlocked(struct ScriptContext *ctx)
+{
+    u32 region;
+    u32 badge;
+
+    (void)ctx;
+    gSpecialVar_Result = TRUE;
+    for (region = REGION_KANTO; region <= REGION_HOENN; region++)
+    {
+        for (badge = 0; badge < NUM_BADGES; badge++)
+        {
+            if (!HasBadge((enum Region)region, badge))
+            {
+                gSpecialVar_Result = FALSE;
+                return;
+            }
+        }
+    }
+}
+
+// The Pokedex check migrates v0.4 saves cleanly: that version's Cerulean
+// marker also meant "defeated", while a caught Mew is unambiguous in the Dex.
+// New v5 catches set the canonical flag as well, so either durable record is
+// sufficient to prevent a duplicate.
+void FinalMewReward_ScrHasBeenCaught(struct ScriptContext *ctx)
+{
+    (void)ctx;
+    gSpecialVar_Result = FlagGet(FLAG_CAUGHT_MEW)
+                       || GetSetPokedexFlag(NATIONAL_DEX_MEW, FLAG_GET_CAUGHT);
+}
+
+// Build the one catchable final-reward Mew immediately before its legendary
+// battle. Creating it here bypasses ordinary Hoenn encounter level scaling,
+// which would otherwise turn a requested level 80 static encounter into 100.
+void FinalMewReward_ScrCreateEncounter(struct ScriptContext *ctx)
+{
+    struct Pokemon *mew = &gParties[B_TRAINER_OPPONENT_A][0];
+    u32 personality = GetMonPersonality(SPECIES_MEW, MON_GENDER_RANDOM, NATURE_TIMID,
+                                        RANDOM_UNOWN_LETTER);
+    u8 zeroEv = 0;
+    u8 hpEv = 4;
+    u8 maxEv = 252;
+    bool8 fatefulEncounter = TRUE;
+
+    (void)ctx;
+    ZeroEnemyPartyMons();
+    CreateMonWithIVs(mew, SPECIES_MEW, 80, personality, OTID_STRUCT_PLAYER_ID,
+                     MAX_PER_STAT_IVS);
+
+    // 4 HP / 252 Sp. Atk / 252 Speed, with every IV fixed at 31 above.
+    SetMonData(mew, MON_DATA_HP_EV, &hpEv);
+    SetMonData(mew, MON_DATA_ATK_EV, &zeroEv);
+    SetMonData(mew, MON_DATA_DEF_EV, &zeroEv);
+    SetMonData(mew, MON_DATA_SPEED_EV, &maxEv);
+    SetMonData(mew, MON_DATA_SPATK_EV, &maxEv);
+    SetMonData(mew, MON_DATA_SPDEF_EV, &zeroEv);
+
+    SetMonMoveSlot(mew, MOVE_PSYCHIC, 0);
+    SetMonMoveSlot(mew, MOVE_AURA_SPHERE, 1);
+    SetMonMoveSlot(mew, MOVE_ICE_BEAM, 2);
+    SetMonMoveSlot(mew, MOVE_FLAMETHROWER, 3);
+    SetMonData(mew, MON_DATA_MODERN_FATEFUL_ENCOUNTER, &fatefulEncounter);
+    MonRestorePP(mew);
+    CalculateMonStats(mew);
+}
