+    public static void BuildSpecies(string sourcePath, string destinationDirectory, int battleMaxSize, string family)
+    {
+        Color[] normalPalette = PsychicPalette;
+        Color[] shinyPalette = PsychicShinyPalette;
+        Color[] iconPalette = PsychicIconPalette;
+        if (family == "water") { normalPalette = WaterPalette; shinyPalette = WaterShinyPalette; iconPalette = WaterIconPalette; }
+        if (family == "fire")  { normalPalette = FirePalette;  shinyPalette = FireShinyPalette;  iconPalette = FireIconPalette; }
+        if (family == "ghost") { normalPalette = GhostPalette; shinyPalette = GhostShinyPalette; iconPalette = WaterIconPalette; }
+        if (family == "dog")   { normalPalette = DogPalette;   shinyPalette = DogShinyPalette;   iconPalette = FireIconPalette; }
+        Directory.CreateDirectory(destinationDirectory);
+
+        int actionColumn = 1, actionRow = 0;
+        int backColumn = 2, backRow = 0;
+        int southColumn = 0, southRow = 1;
+        int northColumn = 1, northRow = 1;
+        int westColumn = 2, westRow = 1;
+        if (family == "dog")
+        {
+            // The approved Danyip source sheets are laid out as battle front,
+            // battle rear, south / north, west, east. Keep two identical front
+            // frames until a hand-authored breathing frame is available.
+            actionColumn = 0; actionRow = 0;
+            backColumn = 1; backRow = 0;
+            southColumn = 2; southRow = 0;
+            northColumn = 0; northRow = 1;
+            westColumn = 1; westRow = 1;
+        }
+
+        using (Bitmap source = new Bitmap(sourcePath))
+        using (Bitmap frontIdle = ExtractCell(source, 0, 0))
+        using (Bitmap frontAction = ExtractCell(source, actionColumn, actionRow))
+        using (Bitmap battleBack = ExtractCell(source, backColumn, backRow))
+        using (Bitmap overworldSouth = ExtractCell(source, southColumn, southRow))
+        using (Bitmap overworldNorth = ExtractCell(source, northColumn, northRow))
+        using (Bitmap overworldWest = ExtractCell(source, westColumn, westRow))
+        using (Bitmap frontSheet = new Bitmap(64, 128, PixelFormat.Format32bppArgb))
+        using (Bitmap backSheet = new Bitmap(64, 64, PixelFormat.Format32bppArgb))
+        using (Bitmap iconSheet = new Bitmap(32, 64, PixelFormat.Format32bppArgb))
+        using (Bitmap followerSheet = new Bitmap(192, 32, PixelFormat.Format32bppArgb))
+        {
+            ClearTransparent(frontSheet);
+            ClearTransparent(backSheet);
+            ClearTransparent(iconSheet);
+            ClearTransparent(followerSheet);
+
+            PlaceFitted(frontSheet, frontIdle, 0, 0, 64, 64, battleMaxSize, battleMaxSize, 0);
+            PlaceFitted(frontSheet, frontAction, 0, 64, 64, 64, battleMaxSize, battleMaxSize, 0);
+            PlaceFitted(backSheet, battleBack, 0, 0, 64, 64, battleMaxSize, battleMaxSize, 0);
+
+            PlaceFitted(iconSheet, frontIdle, 0, 0, 32, 32, 29, 29, 0);
+            PlaceFitted(iconSheet, frontAction, 0, 32, 32, 32, 29, 29, 0);
+
+            PlaceFollowerPair(followerSheet, overworldSouth, 0);
+            PlaceFollowerPair(followerSheet, overworldNorth, 64);
+            PlaceFollowerPair(followerSheet, overworldWest, 128);
+
+            SaveIndexed(frontSheet, Path.Combine(destinationDirectory, "anim_front.png"), normalPalette);
+            SaveIndexed(backSheet, Path.Combine(destinationDirectory, "back.png"), normalPalette);
+            SaveIndexed(iconSheet, Path.Combine(destinationDirectory, "icon.png"), iconPalette);
+            SaveIndexed(followerSheet, Path.Combine(destinationDirectory, "overworld.png"), normalPalette);
+        }
+
+        WritePalette(Path.Combine(destinationDirectory, "normal.pal"), normalPalette);
+        WritePalette(Path.Combine(destinationDirectory, "shiny.pal"), shinyPalette);
+        WritePalette(Path.Combine(destinationDirectory, "overworld_normal.pal"), normalPalette);
+        WritePalette(Path.Combine(destinationDirectory, "overworld_shiny.pal"), shinyPalette);
+    }
+
+    private static Bitmap ExtractCell(Bitmap source, int column, int row)
+    {
+        int cellWidth = source.Width / 3;
+        int cellHeight = source.Height / 2;
+        Bitmap result = new Bitmap(cellWidth, cellHeight, PixelFormat.Format32bppArgb);
+
+        for (int y = 0; y < cellHeight; y++)
+        {
+            for (int x = 0; x < cellWidth; x++)
+            {
+                Color pixel = source.GetPixel(column * cellWidth + x, row * cellHeight + y);
+                int max = Math.Max(pixel.R, Math.Max(pixel.G, pixel.B));
+                int min = Math.Min(pixel.R, Math.Min(pixel.G, pixel.B));
+
+                // Image generation may render a neutral checkerboard instead of
+                // encoding alpha. Treat only the near-white neutral background as
+                // transparent so pale pink highlights remain intact.
+                if (min >= 232 && max - min <= 5)
+                    result.SetPixel(x, y, Color.FromArgb(0, 0, 255, 0));
+                else
+                    result.SetPixel(x, y, Color.FromArgb(255, pixel.R, pixel.G, pixel.B));
+            }
+        }
+
+        return result;
+    }
+
+    private static Rectangle FindOpaqueBounds(Bitmap source)
+    {
+        int minX = source.Width;
+        int minY = source.Height;
+        int maxX = -1;
+        int maxY = -1;
+
+        for (int y = 0; y < source.Height; y++)
+        {
+            for (int x = 0; x < source.Width; x++)
+            {
+                if (source.GetPixel(x, y).A == 0)
+                    continue;
+
+                minX = Math.Min(minX, x);
+                minY = Math.Min(minY, y);
+                maxX = Math.Max(maxX, x);
+                maxY = Math.Max(maxY, y);
+            }
+        }
+
+        if (maxX < minX || maxY < minY)
+            throw new InvalidDataException("Sprite cell contains no opaque pixels.");
+
+        return Rectangle.FromLTRB(minX, minY, maxX + 1, maxY + 1);
+    }
+
+    private static void PlaceFitted(Bitmap destination, Bitmap source, int cellX, int cellY,
+                                    int cellWidth, int cellHeight, int maxWidth, int maxHeight,
+                                    int verticalOffset)
+    {
+        Rectangle bounds = FindOpaqueBounds(source);
+        double scale = Math.Min((double)maxWidth / bounds.Width, (double)maxHeight / bounds.Height);
+        int drawWidth = Math.Max(1, (int)Math.Round(bounds.Width * scale));
+        int drawHeight = Math.Max(1, (int)Math.Round(bounds.Height * scale));
+        int drawX = cellX + (cellWidth - drawWidth) / 2;
+        int drawY = cellY + cellHeight - drawHeight + verticalOffset;
+
+        using (Graphics graphics = Graphics.FromImage(destination))
+        {
+            graphics.CompositingMode = CompositingMode.SourceCopy;
+            graphics.CompositingQuality = CompositingQuality.HighSpeed;
+            graphics.InterpolationMode = InterpolationMode.NearestNeighbor;
+            graphics.PixelOffsetMode = PixelOffsetMode.Half;
+            graphics.SmoothingMode = SmoothingMode.None;
+            graphics.DrawImage(source,
+                new Rectangle(drawX, drawY, drawWidth, drawHeight),
+                bounds,
+                GraphicsUnit.Pixel);
+        }
+    }
+
+    private static void PlaceFollowerPair(Bitmap destination, Bitmap source, int pairX)
+    {
+        PlaceFitted(destination, source, pairX, 0, 32, 32, 30, 30, 0);
+        PlaceFitted(destination, source, pairX + 32, 0, 32, 32, 30, 30, -1);
+    }
+
+    private static void ClearTransparent(Bitmap bitmap)
+    {
+        using (Graphics graphics = Graphics.FromImage(bitmap))
+        {
+            graphics.CompositingMode = CompositingMode.SourceCopy;
+            graphics.Clear(Color.FromArgb(0, 0, 255, 0));
+        }
+    }
+
+    private static byte FindNearestPaletteIndex(Color color, Color[] palette)
+    {
+        if (color.A < 128)
+            return 0;
+
+        int bestDistance = Int32.MaxValue;
+        byte bestIndex = 1;
+        for (byte i = 1; i < palette.Length; i++)
+        {
+            int red = color.R - palette[i].R;
+            int green = color.G - palette[i].G;
+            int blue = color.B - palette[i].B;
+            int distance = red * red + green * green + blue * blue;
+            if (distance < bestDistance)
+            {
+                bestDistance = distance;
+                bestIndex = i;
+            }
+        }
+
+        return bestIndex;
+    }
+
+    private static void SaveIndexed(Bitmap source, string destinationPath, Color[] sourcePalette)
+    {
+        using (Bitmap indexed = new Bitmap(source.Width, source.Height, PixelFormat.Format8bppIndexed))
+        {
+            ColorPalette palette = indexed.Palette;
+            for (int i = 0; i < palette.Entries.Length; i++)
+                palette.Entries[i] = i < sourcePalette.Length ? sourcePalette[i] : Color.Black;
+            indexed.Palette = palette;
+
+            Rectangle rectangle = new Rectangle(0, 0, indexed.Width, indexed.Height);
+            BitmapData data = indexed.LockBits(rectangle, ImageLockMode.WriteOnly, PixelFormat.Format8bppIndexed);
+            byte[] row = new byte[data.Stride];
+            try
+            {
+                for (int y = 0; y < indexed.Height; y++)
+                {
+                    Array.Clear(row, 0, row.Length);
+                    for (int x = 0; x < indexed.Width; x++)
+                        row[x] = FindNearestPaletteIndex(source.GetPixel(x, y), sourcePalette);
+                    Marshal.Copy(row, 0, IntPtr.Add(data.Scan0, y * data.Stride), data.Stride);
+                }
+            }
+            finally
+            {
+                indexed.UnlockBits(data);
+            }
+
+            indexed.Save(destinationPath, ImageFormat.Png);
+        }
+    }
+
+    private static void WritePalette(string destinationPath, Color[] palette)
+    {
+        using (StreamWriter writer = new StreamWriter(destinationPath, false))
+        {
+            writer.WriteLine("JASC-PAL");
+            writer.WriteLine("0100");
+            writer.WriteLine("16");
+            foreach (Color color in palette)
+                writer.WriteLine(String.Format("{0} {1} {2}", color.R, color.G, color.B));
+        }
+    }
+}
+'@
+
+$sourceRootFull = (Resolve-Path -LiteralPath $SourceRoot).Path
+$outputRootFull = [System.IO.Path]::GetFullPath($OutputRoot)
+
+$species = @(
+    @{ Name = "psyshell";    Source = "psyshell-turnaround-v1.png";    BattleSize = 56; Family = "psychic" },
+    @{ Name = "verdachell";  Source = "verdachell-turnaround-v1.png";  BattleSize = 60; Family = "psychic" },
+    @{ Name = "astrachell";  Source = "astrachell-turnaround-v2.png";  BattleSize = 64; Family = "psychic" },
+    @{ Name = "amphid";      Source = "amphid-turnaround-v1.png";      BattleSize = 54; Family = "water" },
+    @{ Name = "amphlume";    Source = "amphlume-turnaround-v1.png";    BattleSize = 60; Family = "water" },
+    @{ Name = "amphidrake";  Source = "amphidrake-turnaround-v1.png";  BattleSize = 64; Family = "water" },
+    @{ Name = "joeyro";      Source = "joeyro-turnaround-v1.png";      BattleSize = 54; Family = "fire" },
+    @{ Name = "kickaroo";    Source = "kickaroo-turnaround-v1.png";    BattleSize = 60; Family = "fire" },
+    @{ Name = "kangarooze";  Source = "kangarooze-turnaround-v1.png";  BattleSize = 64; Family = "fire" },
+    @{ Name = "fintom";      Source = "fintom-turnaround-v1.png";      BattleSize = 54; Family = "ghost" },
+    @{ Name = "hauntide";    Source = "hauntide-turnaround-v1.png";    BattleSize = 60; Family = "ghost" },
+    @{ Name = "sharkraith";  Source = "sharkraith-turnaround-v1.png";  BattleSize = 64; Family = "ghost" }
+    @{ Name = "danyip";      Source = "danyip-turnaround-v1.png";      BattleSize = 52; Family = "dog" },
+    @{ Name = "danny";       Source = "danny-turnaround-v1.png";       BattleSize = 59; Family = "dog" },
+    @{ Name = "danimal";     Source = "danimal-turnaround-v1.png";     BattleSize = 64; Family = "dog" }
+)
+
+if ($Only.Count -gt 0) {
+    $wanted = [System.Collections.Generic.HashSet[string]]::new([string[]]$Only, [System.StringComparer]::OrdinalIgnoreCase)
+    $species = @($species | Where-Object { $wanted.Contains($_.Name) })
+    if ($species.Count -ne $wanted.Count) {
+        throw "One or more names passed to -Only are not defined species."
+    }
+}
+
+foreach ($entry in $species) {
+    $source = Join-Path $sourceRootFull $entry.Source
+    $destination = Join-Path $outputRootFull $entry.Name
+    [JourneySpriteBuilder]::BuildSpecies($source, $destination, $entry.BattleSize, $entry.Family)
+    Copy-Item -LiteralPath (Join-Path $outputRootFull "phycub\footprint.png") `
+        -Destination (Join-Path $destination "footprint.png") -Force
+}
+
+Write-Host "Built Pokémon Journey custom-species sprites in $outputRootFull"
