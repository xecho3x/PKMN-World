+#!/usr/bin/env python3
+"""Validate PokeMan Journey v5.2's permanent custom species and acquisition paths."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from PIL import Image
+
+
+ROOT = Path(__file__).resolve().parents[1]
+FAMILIES = (
+    ("psyshell", "Psyshell", "PSYSHELL", "CHIMCHAR"),
+    ("verdachell", "Verdachell", "VERDACHELL", "MONFERNO"),
+    ("astrachell", "Astrachell", "ASTRACHELL", "INFERNAPE"),
+    ("amphid", "Amphid", "AMPHID", "PIPLUP"),
+    ("amphlume", "Amphlume", "AMPHLUME", "PRINPLUP"),
+    ("amphidrake", "Amphidrake", "AMPHIDRAKE", "EMPOLEON"),
+    ("joeyro", "Joeyro", "JOEYRO", "STARLY"),
+    ("kickaroo", "Kickaroo", "KICKAROO", "STARAVIA"),
+    ("kangarooze", "Kangarooze", "KANGAROOZE", "STARAPTOR"),
+    ("fintom", "Fintom", "FINTOM", "BIDOOF"),
+    ("hauntide", "Hauntide", "HAUNTIDE", "BIBAREL"),
+    ("sharkraith", "Sharkraith", "SHARKRAITH", "KRICKETOT"),
+)
+EXPECTED_IMAGES = {
+    "anim_front.png": (64, 128),
+    "back.png": (64, 64),
+    "icon.png": (32, 64),
+    "overworld.png": (192, 32),
+    "footprint.png": (16, 16),
+}
+
+
+def text(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def require(path: str, *needles: str) -> str:
+    value = text(path)
+    for needle in needles:
+        assert needle in value, f"{path}: missing {needle!r}"
+    return value
+
+
+def has_pixels(image: Image.Image, box: tuple[int, int, int, int]) -> bool:
+    return any(alpha for *_, alpha in image.convert("RGBA").crop(box).getdata())
+
+
+def validate_images() -> None:
+    for folder, _, _, _ in FAMILIES:
+        directory = ROOT / "graphics" / "pokemon" / folder
+        assert directory.is_dir(), f"missing {directory}"
+        for filename, size in EXPECTED_IMAGES.items():
+            path = directory / filename
+            assert path.is_file(), f"missing {path}"
+            with Image.open(path) as image:
+                assert image.size == size, f"{path}: expected {size}, got {image.size}"
+                colors = set(image.convert("RGBA").getdata())
+                assert len(colors) <= (2 if filename == "footprint.png" else 16), (
+                    f"{path}: too many colors ({len(colors)})"
+                )
+                if filename != "footprint.png":
+                    assert image.mode == "P", f"{path}: expected indexed PNG"
+                    assert image.convert("RGBA").getpixel((0, 0))[3] == 0, (
+                        f"{path}: top-left/index 0 must be transparent"
+                    )
+        with Image.open(directory / "anim_front.png") as image:
+            assert has_pixels(image, (0, 0, 64, 64))
+            assert has_pixels(image, (0, 64, 64, 128))
+        with Image.open(directory / "icon.png") as image:
+            assert has_pixels(image, (0, 0, 32, 32))
+            assert has_pixels(image, (0, 32, 32, 64))
+        with Image.open(directory / "overworld.png") as image:
+            for frame in range(6):
+                assert has_pixels(image, (frame * 32, 0, frame * 32 + 32, 32))
+        normal = (directory / "normal.pal").read_text(encoding="ascii")
+        shiny = (directory / "shiny.pal").read_text(encoding="ascii")
+        assert normal.startswith("JASC-PAL\n0100\n16\n")
+        assert shiny.startswith("JASC-PAL\n0100\n16\n")
+        assert normal != shiny, f"{folder}: shiny palette matches normal"
+
+
+def validate_species() -> None:
+    species_h = text("include/constants/species.h")
+    pokedex_h = text("include/constants/pokedex.h")
+    info = text("src/data/pokemon/species_info/journey_custom.h")
+    gfx = text("src/data/graphics/pokemon.h")
+    followers = text("src/data/object_events/object_event_pic_tables_followers.h")
+    for folder, proper, custom, backing in FAMILIES:
+        assert f"#define SPECIES_{custom}" in species_h and f"SPECIES_{backing}" in species_h
+        assert f"#define NATIONAL_DEX_{custom}" in pokedex_h
+        assert f"[SPECIES_{custom}] =" in info
+        assert f"gMonFrontPic_{proper}[]" in gfx
+        assert f'graphics/pokemon/{folder}/anim_front.png' in gfx
+        assert f"JOURNEY_FOLLOWER_TABLE({proper})" in followers
+    assert "#define NATIONAL_DEX_COUNT  NATIONAL_DEX_LUXIO" in pokedex_h
+    assert info.count(".types = MON_TYPES(TYPE_PSYCHIC, TYPE_GRASS)") == 3
+    assert info.count(".types = MON_TYPES(TYPE_WATER, TYPE_DRAGON)") == 3
+    assert info.count(".types = MON_TYPES(TYPE_FIRE, TYPE_FIGHTING)") == 3
+    assert info.count(".types = MON_TYPES(TYPE_WATER, TYPE_GHOST)") == 3
+    for evolution in (
+        "{EVO_LEVEL, 16, SPECIES_VERDACHELL}",
+        "{EVO_LEVEL, 32, SPECIES_ASTRACHELL}",
+        "{EVO_LEVEL, 16, SPECIES_AMPHLUME}",
+        "{EVO_LEVEL, 32, SPECIES_AMPHIDRAKE}",
+        "{EVO_LEVEL, 16, SPECIES_KICKAROO}",
+        "{EVO_LEVEL, 32, SPECIES_KANGAROOZE}",
+        "{EVO_LEVEL, 24, SPECIES_HAUNTIDE}",
+        "{EVO_LEVEL, 44, SPECIES_SHARKRAITH}",
+    ):
+        assert evolution in info
+
+
+def validate_moves() -> None:
+    levels = require(
+        "src/data/pokemon/level_up_learnsets/journey_custom.h",
+        "sPsyshellLevelUpLearnset",
+        "sAmphidLevelUpLearnset",
+        "sJoeyroLevelUpLearnset",
+        "sFintomLevelUpLearnset",
+        "LEVEL_UP_MOVE(70, MOVE_STORED_POWER)",
+        "LEVEL_UP_MOVE(72, MOVE_WATER_SPOUT)",
+        "LEVEL_UP_MOVE(72, MOVE_VICTORY_DANCE)",
+        "LEVEL_UP_MOVE(72, MOVE_LAST_RESPECTS)",
+    )
+    assert levels.count("LEVEL_UP_END") >= 5
+    require(
+        "src/data/pokemon/egg_moves.h",
+        "sPsyshellEggMoveLearnset",
+        "sAmphidEggMoveLearnset",
+        "sJoeyroEggMoveLearnset",
+        "sFintomEggMoveLearnset",
+    )
+    learnables = json.loads(text("src/data/pokemon/all_learnables.json"))
+    assert "PSYSHELL" in learnables
+    for move in ("MOVE_CALM_MIND", "MOVE_ENERGY_BALL", "MOVE_GIGA_DRAIN", "MOVE_PSYCHIC"):
+        assert move in learnables["PSYSHELL"], f"Psyshell missing {move}"
+
+
+def validate_progression() -> None:
+    starter = require(
+        "src/starter_choose.c",
+        "[REGION_KANTO] = { SPECIES_PSYSHELL,   SPECIES_AMPHID,    SPECIES_JOEYRO",
+    )
+    assert "SPECIES_BULBASAUR,  SPECIES_MUDKIP,    SPECIES_CYNDAQUIL" not in starter
+    lab = require(
+        "data/maps/PalletTown_ProfessorOaksLab_Frlg/scripts.inc",
+        "setvar PLAYER_STARTER_SPECIES, SPECIES_PSYSHELL",
+        "setvar RIVAL_STARTER_SPECIES, SPECIES_JOEYRO",
+        "setvar PLAYER_STARTER_SPECIES, SPECIES_AMPHID",
+        "setvar RIVAL_STARTER_SPECIES, SPECIES_PSYSHELL",
+        "setvar PLAYER_STARTER_SPECIES, SPECIES_JOEYRO",
+        "setvar RIVAL_STARTER_SPECIES, SPECIES_AMPHID",
+    )
+    for flag in (
+        "FLAG_V52_PSYSHELL_CLAIMED",
+        "FLAG_V52_AMPHID_CLAIMED",
+        "FLAG_V52_JOEYRO_CLAIMED",
+    ):
+        assert flag in lab, f"Oak's Lab does not set {flag}"
+    require("data/maps/CeladonCity_Gym_Frlg/scripts.inc", "givemon VAR_0x8004, 22", "SPECIES_PSYSHELL")
+    require("data/maps/SeafoamIslands_B4F_Frlg/scripts.inc", "givemon SPECIES_AMPHID, 25")
+    require("data/maps/MtEmber_Exterior_Frlg/scripts.inc", "givemon SPECIES_JOEYRO, 30")
+    wild = text("src/data/wild_encounters.json")
+    for species in ("SPECIES_BULBASAUR", "SPECIES_CYNDAQUIL", "SPECIES_MUDKIP", "SPECIES_FINTOM"):
+        assert species in wild
+    require("src/battle_main.c", "SPECIES_PSYSHELL", "SPECIES_AMPHIDRAKE", "SPECIES_KANGAROOZE")
+
+
+def validate_identity() -> None:
+    require("Makefile", "TITLE        ?= POKEMAN V530", "REVISION    := 14", "pokeman_journey_v530_danyip")
+    require("src/main_menu.c", "NEW GAME  V5.3")
+
+
+def main() -> None:
+    validate_images()
+    validate_species()
+    validate_moves()
+    validate_progression()
+    validate_identity()
+    print("v5.2 custom content validated: 12 species, 60 sprite sheets, starter counters, and acquisition paths")
+
+
+if __name__ == "__main__":
+    main()
