index 0000000000000000000000000000000000000000..64196c922b457be35f60fee10d1e6cde7d4faa47
--- /dev/null
+++ b/test/battle/ability/annoy.c
@@ -0,0 +1,219 @@
+#include "global.h"
+#include "test/battle.h"
+
+SINGLE_BATTLE_TEST("Annoy confuses the opposing source of a direct major status")
+{
+    enum Move move;
+
+    PARAMETRIZE { move = MOVE_WILL_O_WISP; }
+    PARAMETRIZE { move = MOVE_POISON_GAS; }
+    PARAMETRIZE { move = MOVE_TOXIC; }
+    PARAMETRIZE { move = MOVE_THUNDER_WAVE; }
+    PARAMETRIZE { move = MOVE_HYPNOSIS; }
+
+    GIVEN {
+        ASSUME(GetMoveEffect(move) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, move); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(player->status1 & STATUS1_ANY);
+        EXPECT(opponent->volatiles.confusionTurns > 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy answers freeze or frostbite")
+{
+    GIVEN {
+        ASSUME(MoveHasAdditionalEffect(MOVE_POWDER_SNOW, MOVE_EFFECT_FREEZE_OR_FROSTBITE));
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_POWDER_SNOW, WITH_RNG(RNG_SECONDARY_EFFECT, TRUE)); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(player->status1 & (STATUS1_FREEZE | STATUS1_FROSTBITE));
+        EXPECT(opponent->volatiles.confusionTurns > 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy does not activate from Rest")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_REST) == EFFECT_REST);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); HP(1); MaxHP(300); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(player, MOVE_REST); }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(player, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        }
+    } THEN {
+        EXPECT(player->status1 & STATUS1_SLEEP);
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy does not activate from Toxic Spikes")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_TOXIC_SPIKES) == EFFECT_TOXIC_SPIKES);
+        PLAYER(SPECIES_WOBBUFFET);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_TOXIC_SPIKES); }
+        TURN { SWITCH(player, 1); }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(player, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        }
+    } THEN {
+        EXPECT(player->status1 & STATUS1_POISON);
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy does not activate from held status orbs")
+{
+    enum Item item;
+
+    PARAMETRIZE { item = ITEM_FLAME_ORB; }
+    PARAMETRIZE { item = ITEM_TOXIC_ORB; }
+
+    GIVEN {
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); Item(item); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(player, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        }
+    } THEN {
+        EXPECT(player->status1 & STATUS1_ANY);
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy does not activate when the status attempt fails")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); Status1(STATUS1_BURN); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_WILL_O_WISP); }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(player, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        }
+    } THEN {
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+DOUBLE_BATTLE_TEST("Annoy does not activate when an ally supplies the status")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        PLAYER(SPECIES_WYNAUT);
+        OPPONENT(SPECIES_WOBBUFFET);
+        OPPONENT(SPECIES_WYNAUT);
+    } WHEN {
+        TURN { MOVE(playerRight, MOVE_WILL_O_WISP, target: playerLeft); }
+    } SCENE {
+        NONE_OF {
+            ABILITY_POPUP(playerLeft, ABILITY_ANNOY);
+            ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, playerRight);
+        }
+    } THEN {
+        EXPECT(playerLeft->status1 & STATUS1_BURN);
+        EXPECT(playerRight->volatiles.confusionTurns == 0);
+    }
+}
+
+DOUBLE_BATTLE_TEST("Annoy confuses only the opposing battler that supplied the status")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        PLAYER(SPECIES_WYNAUT);
+        OPPONENT(SPECIES_WOBBUFFET);
+        OPPONENT(SPECIES_WYNAUT);
+    } WHEN {
+        TURN { MOVE(opponentRight, MOVE_WILL_O_WISP, target: playerLeft); }
+    } SCENE {
+        ABILITY_POPUP(playerLeft, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponentRight);
+        NOT ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponentLeft);
+    } THEN {
+        EXPECT(opponentLeft->volatiles.confusionTurns == 0);
+        EXPECT(opponentRight->volatiles.confusionTurns > 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy respects Own Tempo confusion immunity")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_SLOWPOKE) { Ability(ABILITY_OWN_TEMPO); }
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_WILL_O_WISP); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        NOT ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy respects Substitute confusion protection")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_WILL_O_WISP) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_SUBSTITUTE); }
+        TURN { MOVE(opponent, MOVE_WILL_O_WISP); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        NOT ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(opponent->volatiles.confusionTurns == 0);
+    }
+}
+
+SINGLE_BATTLE_TEST("Annoy can activate again after both statuses are cured")
+{
+    GIVEN {
+        ASSUME(GetMoveEffect(MOVE_POISON_GAS) == EFFECT_NON_VOLATILE_STATUS);
+        PLAYER(SPECIES_WOBBUFFET) { Ability(ABILITY_ANNOY); Item(ITEM_LUM_BERRY); }
+        OPPONENT(SPECIES_WOBBUFFET) { Item(ITEM_PERSIM_BERRY); }
+    } WHEN {
+        TURN { MOVE(opponent, MOVE_POISON_GAS); }
+        TURN { MOVE(opponent, MOVE_POISON_GAS); }
+    } SCENE {
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+        ABILITY_POPUP(player, ABILITY_ANNOY);
+        ANIMATION(ANIM_TYPE_STATUS, B_ANIM_STATUS_CONFUSION, opponent);
+    } THEN {
+        EXPECT(player->status1 & STATUS1_POISON);
+        EXPECT(opponent->volatiles.confusionTurns > 0);
+    }
+}
diff --git a/Testing/ValidateDanyipLine.py b/Testing/ValidateDanyipLine.py
new file mode 100644
index 0000000000000000000000000000000000000000..51783ce4603db5776276566fcc01657020583b58
--- /dev/null
+++ b/Testing/ValidateDanyipLine.py
@@ -0,0 +1,172 @@
+#!/usr/bin/env python3
+"""Structural release gate for Journey's Danyip -> Danny -> Danimal line."""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+
+from PIL import Image
+
+
+ROOT = Path(__file__).resolve().parents[1]
+FORMS = (
+    ("danyip", "Danyip", "DANYIP", "KRICKETUNE", (50, 55, 45, 70, 35, 45)),
+    ("danny", "Danny", "DANNY", "SHINX", (70, 80, 65, 95, 45, 65)),
+    ("danimal", "Danimal", "DANIMAL", "LUXIO", (90, 115, 90, 95, 55, 80)),
+)
+SLOT_WEIGHTS = (20, 20, 10, 10, 10, 10, 5, 5, 4, 4, 1, 1)
+
+
+def read(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise AssertionError(message)
+
+
+def species_block(info: str, name: str) -> str:
+    start = info.index(f"[SPECIES_{name}] =")
+    end = info.find("\n},", start)
+    require(end >= 0, f"unterminated species block for {name}")
+    return info[start:end]
+
+
+def validate_ids_and_species() -> None:
+    species = read("include/constants/species.h")
+    dex = read("include/constants/pokedex.h")
+    info = read("src/data/pokemon/species_info/journey_custom.h")
+    fields = ("baseHP", "baseAttack", "baseDefense", "baseSpeed", "baseSpAttack", "baseSpDefense")
+
+    require("#define NATIONAL_DEX_COUNT  NATIONAL_DEX_LUXIO" in dex,
+            "National Dex must expose Danyip's line through #404")
+    for _, proper, custom, backing, stats in FORMS:
+        require(re.search(rf"#define SPECIES_{custom}\s+SPECIES_{backing}\b", species) is not None,
+                f"{custom} does not retain its assigned dormant ID")
+        require(f"#define NATIONAL_DEX_{custom}" in dex, f"missing {custom} Pokédex alias")
+        block = species_block(info, custom)
+        require('.types = MON_TYPES(TYPE_NORMAL)' in block, f"{proper} is not pure Normal")
+        require(block.count("ABILITY_ANNOY") == 3, f"{proper} must use Annoy in all ability slots")
+        require(".genderRatio = PERCENT_FEMALE(50)" in block, f"{proper} gender ratio changed")
+        require(".eggCycles = 15" in block, f"{proper} egg cycles changed")
+        require("EGG_GROUP_FIELD" in block, f"{proper} is not in Field")
+        require("GROWTH_MEDIUM_FAST" in block, f"{proper} growth changed")
+        require("BODY_COLOR_BROWN" in block, f"{proper} body color changed")
+        for field, value in zip(fields, stats):
+            require(re.search(rf"\.{field}\s*=\s*{value}\b", block) is not None,
+                    f"{proper} {field} is not {value}")
+
+    require("{EVO_LEVEL, 16, SPECIES_DANNY}" in info, "Danyip level-16 evolution missing")
+    require("{EVO_LEVEL, 32, SPECIES_DANIMAL}" in info, "Danny level-32 evolution missing")
+
+
+def validate_moves_and_ability() -> None:
+    levels = read("src/data/pokemon/level_up_learnsets/journey_custom.h")
+    learnables = json.loads(read("src/data/pokemon/all_learnables.json"))
+    abilities = read("src/data/abilities.h")
+    battle = read("src/battle_script_commands.c")
+    scripts = read("data/battle_scripts_1.s")
+    tests = read("test/battle/ability/annoy.c")
+
+    for marker in (
+        "sDanyipLevelUpLearnset", "LEVEL_UP_MOVE(16, MOVE_HEADBUTT)",
+        "LEVEL_UP_MOVE(46, MOVE_DOUBLE_EDGE)", "sDanimalLevelUpLearnset",
+        "LEVEL_UP_MOVE(32, MOVE_SCARY_FACE)", "LEVEL_UP_MOVE(51, MOVE_EXTREME_SPEED)",
+        "LEVEL_UP_MOVE(55, MOVE_DOUBLE_EDGE)",
+    ):
+        require(marker in levels, f"missing learnset marker {marker}")
+    required_teachables = {
+        "MOVE_AGILITY", "MOVE_BODY_SLAM", "MOVE_BRICK_BREAK", "MOVE_BULK_UP",
+        "MOVE_CHARM", "MOVE_CLOSE_COMBAT", "MOVE_CRUNCH", "MOVE_DIG",
+        "MOVE_DOUBLE_TEAM", "MOVE_ENDURE", "MOVE_FACADE", "MOVE_FIRE_FANG",
+        "MOVE_GIGA_IMPACT", "MOVE_HELPING_HAND", "MOVE_HYPER_BEAM", "MOVE_ICE_FANG",
+        "MOVE_IRON_HEAD", "MOVE_PLAY_ROUGH", "MOVE_PROTECT", "MOVE_REST",
+        "MOVE_ROAR", "MOVE_SHADOW_CLAW", "MOVE_SLEEP_TALK", "MOVE_SNARL",
+        "MOVE_SUBSTITUTE", "MOVE_SUNNY_DAY", "MOVE_TAKE_DOWN", "MOVE_TERA_BLAST",
+        "MOVE_THUNDER_FANG", "MOVE_TRAILBLAZE", "MOVE_WORK_UP", "MOVE_ZEN_HEADBUTT",
+    }
+    require(required_teachables <= set(learnables["DANYIP"]), "Danyip teachable list is incomplete")
+    require("[ABILITY_ANNOY]" in abilities and ".aiRating = 3" in abilities,
+            "Annoy ability metadata or AI rating missing")
+    for marker in (
+        "TryAnnoyActivation", "trigger != TRIGGER_ON_MOVE", "IsBattlerAlly",
+        "CanBeConfused(annoyBattler, annoySource)", "PlayCry_Normal",
+        "BattleScript_AnnoyActivates", "BattleScript_AnnoyBlocked",
+    ):
+        require(marker in battle or marker in scripts, f"Annoy pipeline missing {marker}")
+    for phrase in (
+        "Annoy does not activate from Rest", "Annoy does not activate from Toxic Spikes",
+        "Annoy does not activate when an ally supplies the status",
+        "Annoy confuses only the opposing battler that supplied the status",
+        "Annoy respects Own Tempo confusion immunity",
+        "Annoy can activate again after both statuses are cured",
+    ):
+        require(phrase in tests, f"missing battle regression: {phrase}")
+
+
+def validate_art_and_cries() -> None:
+    gfx = read("src/data/graphics/pokemon.h")
+    followers = read("src/data/object_events/object_event_pic_tables_followers.h")
+    cry_constants = read("include/constants/cries.h")
+    cry_table = read("sound/cry_tables.inc")
+    cry_data = read("sound/direct_sound_data.inc")
+    expected = {
+        "anim_front.png": (64, 128), "back.png": (64, 64),
+        "icon.png": (32, 64), "overworld.png": (192, 32), "footprint.png": (16, 16),
+    }
+    for folder, proper, custom, _, _ in FORMS:
+        require(f"gMonFrontPic_{proper}[]" in gfx, f"{proper} graphics not registered")
+        require(f"JOURNEY_FOLLOWER_TABLE({proper})" in followers, f"{proper} follower missing")
+        base = ROOT / "graphics" / "pokemon" / folder
+        for filename, size in expected.items():
+            with Image.open(base / filename) as image:
+                require(image.size == size, f"{folder}/{filename} has wrong dimensions")
+                require(image.mode == "P", f"{folder}/{filename} must be indexed")
+                require(max(image.getdata(), default=0) < (2 if filename == "footprint.png" else 16),
+                        f"{folder}/{filename} exceeds its palette")
+        require((base / "normal.pal").read_bytes() != (base / "shiny.pal").read_bytes(),
+                f"{proper} shiny palette matches normal")
+        require(f"CRY_{custom}" in cry_constants, f"{proper} cry constant missing")
+        require(f"Cry_{proper}" in cry_table and f"Cry_{proper}" in cry_data,
+                f"{proper} cry sample not wired")
+
+    for sample in ("lillipup.bin", "herdier.bin", "stoutland.bin"):
+        require(sample in cry_data, f"requested temporary sample {sample} missing")
+
+
+def validate_encounter_and_orders() -> None:
+    encounters = json.loads(read("src/data/wild_encounters.json"))
+    route_one = []
+    for group in encounters["wild_encounter_groups"]:
+        for encounter in group["encounters"]:
+            if encounter.get("map") == "MAP_ROUTE1" and "land_mons" in encounter:
+                route_one.append(encounter)
+    require({table["base_label"] for table in route_one} == {"sRoute1_FireRed", "sRoute1_LeafGreen"},
+            "Danyip must be available in both Route 1 version tables")
+    for table in route_one:
+        mons = table["land_mons"]["mons"]
+        rate = sum(weight for weight, mon in zip(SLOT_WEIGHTS, mons)
+                   if mon["species"] == "SPECIES_DANYIP")
+        require(rate == 10, f"{table['base_label']} Danyip rate is {rate}%, expected 10%")
+        require(all(mon["min_level"] == 3 and mon["max_level"] == 5
+                    for mon in mons if mon["species"] == "SPECIES_DANYIP"),
+                f"{table['base_label']} Danyip levels must be 3-5")
+    orders = read("src/data/pokemon/pokedex_orders.h")
+    for name in ("DANYIP", "DANNY", "DANIMAL"):
+        require(orders.count(f"NATIONAL_DEX_{name}") == 3,
+                f"{name} must occur once in alphabetical, weight, and height order")
+
+
+def main() -> None:
+    validate_ids_and_species()
+    validate_moves_and_ability()
+    validate_art_and_cries()
+    validate_encounter_and_orders()
+    print("Danyip validation passed: #402-404, Route 1 at 10% (Lv3-5), full art/cries/moves, Annoy regressions present")
+
+
+if __name__ == "__main__":
+    main()
