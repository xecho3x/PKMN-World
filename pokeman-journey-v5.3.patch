+    for path, first_flag, second_flag in (
+        ("data/maps/AzaleaTown_Gym/scripts.inc", "FLAG_GOT_JOHTO_STARTER_REWARD_1", None),
+        ("data/maps/OlivineCity_Gym/scripts.inc", "FLAG_GOT_JOHTO_STARTER_REWARD_2", None),
+        ("data/maps/LavaridgeTown_Gym_1F/scripts.inc", "FLAG_HOENN_STARTER_REWARD_1", None),
+        ("data/maps/FortreeCity_Gym/scripts.inc", "FLAG_HOENN_STARTER_REWARD_2", None),
+    ):
+        require(first_flag in read(path), f"Regional starter reward is missing from {path}")
+
+    olivine_port = read("data/maps/OlivineCity_PortInside/scripts.inc")
+    for token in (
+        "FLAG_JOHTO_CHAMPION",
+        "RegionHub_ScrHoennIntroDone",
+        "RegionHub_ScrEnterRegion",
+        "MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F",
+        "MAP_LITTLEROOT_TOWN_MAYS_HOUSE_2F",
+    ):
+        require(token in olivine_port, f"Johto-to-Hoenn transition is missing {token}")
+
+    progression = read("src/regional_progression.c")
+    for token in ("REGION_KANTO", "REGION_JOHTO", "REGION_HOENN", "5, 35", "33, 70", "70, 100"):
+        require(token in progression, f"Regional level scaling is missing {token}")
+
+    caps = read("src/caps.c")
+    for token in ("10, 13, 16", "37, 41, 45", "73, 77, 81", "leagueCap = 35", "leagueCap = 70"):
+        require(token in caps, f"Regional cap curve is missing {token}")
+
+    pokemon = read("src/pokemon.c")
+    require("TryLearningRegionalMilestoneMove" in pokemon, "High-level milestone moves are disabled")
+    require(
+        "#define P_ENABLE_ALL_LEVEL_UP_MOVES      TRUE" in read("include/config/summary_screen.h"),
+        "The move reminder cannot recover missed high-level moves",
+    )
+
+    print("v5.2 validation passed: custom starters, transitions, collection, regional progression, and final Mew are correct.")
+
+
+if __name__ == "__main__":
+    main()
