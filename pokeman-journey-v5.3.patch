+++ b/tools/export_journey_patch.ps1
@@ -0,0 +1,60 @@
+param(
+    [string[]]$OutputFiles = @(
+        "pokeman-journey-current.patch",
+        "pokeman-journey-v5.3.patch"
+    )
+)
+
+$ErrorActionPreference = "Stop"
+
+$repoRoot = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
+Push-Location $repoRoot
+try {
+    $excluded = @(
+        "pokeman-journey-current.patch",
+        "pokeman-journey-v5.1.patch",
+        "pokeman-journey-v5.2.patch",
+        "pokeman-journey-v5.3.patch",
+        ".github/workflows/build-pokeman-journey.yml"
+    )
+
+    $pathspecs = @(".") + ($excluded | ForEach-Object { ":(exclude)$_" })
+    $trackedDiff = & git diff HEAD --binary --full-index -- @pathspecs
+    if ($LASTEXITCODE -ne 0) {
+        throw "git diff HEAD failed with exit code $LASTEXITCODE"
+    }
+
+    $parts = [System.Collections.Generic.List[string]]::new()
+    if ($trackedDiff) {
+        $parts.Add(($trackedDiff -join "`n"))
+    }
+
+    $untracked = @(& git ls-files --others --exclude-standard) |
+        Where-Object {
+            $_ -and $_ -notin $excluded `
+                -and -not $_.StartsWith("graphics/pokemon/psychell/") `
+                -and -not $_.StartsWith("graphics/pokemon/oracarap/")
+        } |
+        Sort-Object
+
+    foreach ($path in $untracked) {
+        $newFileDiff = & git diff --no-index --binary --full-index -- /dev/null $path
+        if ($LASTEXITCODE -notin @(0, 1)) {
+            throw "git diff --no-index failed for $path with exit code $LASTEXITCODE"
+        }
+        if ($newFileDiff) {
+            $parts.Add(($newFileDiff -join "`n"))
+        }
+    }
+
+    $patchText = ($parts -join "`n") + "`n"
+    $utf8NoBom = [System.Text.UTF8Encoding]::new($false)
+    foreach ($output in $OutputFiles) {
+        $destination = Join-Path $repoRoot $output
+        [System.IO.File]::WriteAllText($destination, $patchText, $utf8NoBom)
+        Write-Host "Wrote $destination"
+    }
+}
+finally {
+    Pop-Location
+}
