+#!/usr/bin/env python3
+"""Release gate for Pokémon Journey's universal-obedience rule."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(relative: str) -> str:
+    return (ROOT / relative).read_text(encoding="utf-8")
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise SystemExit(f"ERROR: {message}")
+
+
+def main() -> None:
+    battle_util = read("src/battle_util.c")
+    match = re.search(
+        r"enum Obedience GetAttackerObedienceForAction\(void\)\s*\{(.*?)\n\}",
+        battle_util,
+        re.DOTALL,
+    )
+    require(match is not None, "obedience function is missing")
+    body = match.group(1)
+    require(body.count("return OBEYS;") == 1, "obedience function must always return OBEYS")
+    for forbidden in ("HasActiveRegionBadge", "obedienceLevel", "DISOBEYS_", "Random()"):
+        require(forbidden not in body, f"obedience function still uses {forbidden}")
+
+    hub = read("data/maps/RegionHub/scripts.inc")
+    require(hub.count("follow your commands in every") == 3,
+            "all three transit prompts must explain universal obedience")
+    require("every POKéMON will follow your" in hub,
+            "hub tour does not explain universal obedience")
+
+    violet = read("data/maps/VioletCity_House1/scripts.inc")
+    sootopolis = read("data/maps/SootopolisCity_Gym_1F/scripts.inc")
+    features = read("FEATURES.md")
+    require("they may disobey you" not in violet, "Violet NPC still warns about disobedience")
+    require("full obedience of all your POKéMON" not in sootopolis,
+            "Rain Badge still claims to unlock obedience")
+    require("Pokémon themselves always\nfollow commands" in features,
+            "feature guide does not document universal obedience")
+
+    print("Universal obedience validation passed: all owned Pokémon always follow commands")
+
+
+if __name__ == "__main__":
+    main()
