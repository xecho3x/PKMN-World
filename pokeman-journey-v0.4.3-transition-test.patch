diff --git a/Testing/ValidateTransitionTest.py b/Testing/ValidateTransitionTest.py
new file mode 100644
index 00000000..f9e37a86
--- /dev/null
+++ b/Testing/ValidateTransitionTest.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Validate the one-off Blaine -> Two Island -> Johto quick-test build."""
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise SystemExit(f"ERROR: {message}")
+
+
+new_game = read("src/new_game.c")
+gym = read("data/maps/CinnabarIsland_Gym_Frlg/scripts.inc")
+island = read("data/maps/TwoIsland_Frlg/scripts.inc")
+menu = read("src/main_menu.c")
+makefile = read("Makefile")
+
+require("MAP_CINNABAR_ISLAND_GYM" in new_game, "new game does not start in Blaine's Gym")
+for badge in range(1, 7):
+    require(f"FlagSet(FLAG_KANTO_BADGE_{badge})" in new_game, f"Kanto badge {badge} is not preloaded")
+for species in ("BLASTOISE", "VAPOREON", "GOLEM"):
+    require(f"SPECIES_{species}" in new_game, f"test party is missing {species}")
+require("CinnabarIsland_Gym_EventScript_TransitionTestWarp" in gym, "post-Blaine test warp is missing")
+require("warp MAP_TWO_ISLAND, 3" in gym, "test warp does not enter Two Island")
+for token in ("FLAG_KANTO_BADGE_7", "TwoIsland_EventScript_OfferJohto", "MAP_NEW_BARK_TOWN_PLAYERS_HOUSE_2F"):
+    require(token in island, f"Two Island handoff is missing {token}")
+require("NEW GAME  V0.4.3 TEST" in menu, "test build is not visibly labelled")
+require("TITLE        ?= PKMN TEST043" in makefile, "test ROM header title is wrong")
+require("REVISION    := 9" in makefile, "test ROM revision is wrong")
+
+print("Transition-test validation passed: Blaine quick start and Two Island Johto handoff are armed.")
diff --git a/Testing/ValidateV04Kanto.py b/Testing/ValidateV04Kanto.py
new file mode 100644
index 00000000..070dea9d
--- /dev/null
+++ b/Testing/ValidateV04Kanto.py
@@ -0,0 +1,295 @@
+"""Validate PokeMan Journey v0.4.3's Kanto collection and Johto handoff."""
+
+import json
+import re
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(path):
+    return (ROOT / path).read_text(encoding="utf-8", errors="ignore")
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def balanced_evolution_targets(block):
+    marker = ".evolutions = EVOLUTION("
+    marker_pos = block.find(marker)
+    if marker_pos < 0:
+        return set()
+
+    start = marker_pos + len(marker)
+    depth = 1
+    pos = start
+    while pos < len(block) and depth:
+        depth += (block[pos] == "(") - (block[pos] == ")")
+        pos += 1
+    require(depth == 0, "Unbalanced EVOLUTION macro in Gen 1 species data")
+    return set(re.findall(r"SPECIES_([A-Z0-9_]+)", block[start : pos - 1]))
+
+
+def main():
+    kanto_map_ids = set()
+    kanto_map_dirs = []
+    for map_json in (ROOT / "data/maps").glob("*/map.json"):
+        try:
+            data = json.loads(map_json.read_text(encoding="utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            continue
+        if data.get("region") == "REGION_KANTO":
+            kanto_map_ids.add(data["id"])
+            kanto_map_dirs.append(map_json.parent)
+
+    encounters = json.loads(read("src/data/wild_encounters.json"))
+    species_by_map = {}
+    levels_by_map_species = {}
+    levels_by_label_species = {}
+    direct_sources = set()
+    for group in encounters["wild_encounter_groups"]:
+        for encounter in group.get("encounters", []):
+            map_id = encounter.get("map")
+            if map_id not in kanto_map_ids:
+                continue
+            base_label = encounter.get("base_label")
+            map_species = species_by_map.setdefault(map_id, set())
+            for key, table in encounter.items():
+                if not key.endswith("_mons") or not isinstance(table, dict):
+                    continue
+                for mon in table.get("mons", []):
+                    species = mon["species"].removeprefix("SPECIES_")
+                    map_species.add(species)
+                    direct_sources.add(species)
+                    levels_by_map_species.setdefault((map_id, species), set()).add(
+                        (mon["min_level"], mon["max_level"])
+                    )
+                    levels_by_label_species.setdefault((base_label, species), set()).add(
+                        (mon["min_level"], mon["max_level"])
+                    )
+
+    for map_dir in kanto_map_dirs:
+        script_path = map_dir / "scripts.inc"
+        if script_path.exists():
+            script = script_path.read_text(encoding="utf-8", errors="ignore")
+            direct_sources.update(
+                re.findall(r"(?:givemon|setwildbattle)\s+SPECIES_([A-Z0-9_]+)", script)
+            )
+
+    # These are variable-driven gifts/prizes and therefore do not appear as literal
+    # givemon operands in the map scripts.
+    direct_sources.update({"BULBASAUR", "CYNDAQUIL", "MUDKIP", "PORYGON"})
+
+    dex_section = read("include/constants/pokedex.h").split("// Kanto", 1)[1].split("// Johto", 1)[0]
+    kanto_species = set(re.findall(r"NATIONAL_DEX_([A-Z0-9_]+)", dex_section))
+    require(len(kanto_species) == 151, f"Expected 151 Kanto species, found {len(kanto_species)}")
+
+    species_info = read("src/data/pokemon/species_info/gen_1_families.h")
+    headers = list(re.finditer(r"^\s*\[SPECIES_([A-Z0-9_]+)\]\s*=", species_info, re.MULTILINE))
+    evolution_edges = {}
+    for index, header in enumerate(headers):
+        block_end = headers[index + 1].start() if index + 1 < len(headers) else len(species_info)
+        block = species_info[header.end() : block_end]
+        evolution_edges[header.group(1)] = balanced_evolution_targets(block)
+
+    reachable = set(direct_sources)
+    while True:
+        expanded = reachable | {
+            target
+            for source, targets in evolution_edges.items()
+            if source in reachable
+            for target in targets
+        }
+        if expanded == reachable:
+            break
+        reachable = expanded
+
+    missing = sorted(kanto_species - reachable)
+    require(not missing, "Unobtainable Kanto species: " + ", ".join(missing))
+
+    expected_rare_encounters = {
+        "MAP_THREE_ISLAND_BERRY_FOREST": {"FARFETCHD": (37, 37), "MR_MIME": (35, 35)},
+        "MAP_SAFARI_ZONE_WEST": {"LICKITUNG": (23, 23)},
+        "MAP_SEAFOAM_ISLANDS_B4F": {"JYNX": (36, 36), "SQUIRTLE": (32, 32)},
+        "MAP_MT_EMBER_EXTERIOR": {"CHARMANDER": (38, 38)},
+        "MAP_VICTORY_ROAD_1F_FRLG": {"HITMONLEE": (46, 46), "HITMONCHAN": (46, 46)},
+    }
+    for map_id, expected_species in expected_rare_encounters.items():
+        missing_here = set(expected_species) - species_by_map.get(map_id, set())
+        require(not missing_here, f"{map_id} is missing rare encounters: {sorted(missing_here)}")
+        for species, expected_levels in expected_species.items():
+            actual_levels = levels_by_map_species.get((map_id, species), set())
+            require(
+                actual_levels == {expected_levels},
+                f"{map_id} {species} levels are {sorted(actual_levels)}, expected {expected_levels}",
+            )
+
+    expected_route_six = {
+        "sRoute6_FireRed": {"EEVEE": (16, 16), "DRATINI": (16, 16), "SCYTHER": (17, 17)},
+        "sRoute6_LeafGreen": {"EEVEE": (16, 16), "DRATINI": (16, 16), "PINSIR": (17, 17)},
+    }
+    for base_label, expected_species in expected_route_six.items():
+        for species, expected_levels in expected_species.items():
+            actual_levels = levels_by_label_species.get((base_label, species), set())
+            require(
+                actual_levels == {expected_levels},
+                f"{base_label} {species} levels are {sorted(actual_levels)}, expected {expected_levels}",
+            )
+
+    route_one_starters = {"BULBASAUR", "CHARMANDER", "SQUIRTLE"} & species_by_map.get("MAP_ROUTE1", set())
+    require(not route_one_starters, f"Route 1 still gives away starters: {sorted(route_one_starters)}")
+
+    for target in ("ALAKAZAM", "MACHAMP", "GOLEM", "GENGAR"):
+        require(
+            f"ITEM_MOON_STONE, SPECIES_{target}" in species_info,
+            f"{target} still lacks its no-trade Moon Stone evolution",
+        )
+
+    mew_script = read("data/maps/CeruleanCave_B1F_Frlg/scripts.inc")
+    for token in ("FLAG_FOUGHT_MEWTWO", "FLAG_V04_FOUGHT_MEW", "setwildbattle SPECIES_MEW, 50"):
+        require(token in mew_script, f"Mew challenge is missing {token}")
+
+    fossil_script = read("data/maps/CinnabarIsland_PokemonLab_ExperimentRoom_Frlg/scripts.inc")
+    for token in ("FLAG_V04_SECOND_FOSSIL_CLAIMED", "ITEM_HELIX_FOSSIL", "ITEM_DOME_FOSSIL"):
+        require(token in fossil_script, f"Dual-fossil path is missing {token}")
+
+    erika = read("data/maps/CeladonCity_Gym_Frlg/scripts.inc")
+    blaine = read("data/maps/CinnabarIsland_Gym_Frlg/scripts.inc")
+    require("FLAG_V04_KANTO_STARTER_BADGE4" in erika, "Erika's starter reward is missing")
+    require("FLAG_V04_KANTO_STARTER_BADGE7" in blaine, "Blaine's starter reward is missing")
+    require("givemon VAR_0x8004, 25" in erika, "Erika's starter reward is not level 25")
+    require("givemon VAR_0x8004, 40" in blaine, "Blaine's starter reward is not level 40")
+    require(
+        "goto_if_eq VAR_STARTER_MON_FRLG, 0, CeladonCity_Gym_EventScript_GiveMudkip" in erika
+        and "goto_if_eq VAR_STARTER_MON_FRLG, 1, CeladonCity_Gym_EventScript_GiveCyndaquil" in erika,
+        "Erika's rewards do not follow the Bulbasaur/Mudkip/Cyndaquil slot order",
+    )
+    require(
+        "goto_if_eq VAR_STARTER_MON_FRLG, 0, CinnabarIsland_Gym_EventScript_GiveCyndaquil" in blaine
+        and "goto_if_eq VAR_STARTER_MON_FRLG, 1, CinnabarIsland_Gym_EventScript_GiveBulbasaur" in blaine,
+        "Blaine's rewards do not give the remaining Kanto starter",
+    )
+
+    for species in ("OMANYTE", "KABUTO", "AERODACTYL"):
+        require(
+            f"givemon SPECIES_{species}, 35" in fossil_script,
+            f"Cinnabar's {species} fossil revival is not level 35",
+        )
+
+    island = read("data/maps/TwoIsland_Frlg/scripts.inc")
+    for token in (
+        "FLAG_KANTO_BADGE_7",
+        "FLAG_JOHTO_STARTER_CHOSEN",
+        "RegionHub_ScrCanDepositParty",
+        "RegionHub_ScrEnterRegion",
+        "MAP_NEW_BARK_TOWN_PLAYERS_HOUSE_2F",
+    ):
+        require(token in island, f"Island Two Johto transition is missing {token}")
+
+    kanto_starter_files = (
+        "data/maps/CeruleanCity_Frlg/scripts.inc",
+        "data/maps/PalletTown_ProfessorOaksLab_Frlg/scripts.inc",
+        "data/maps/PokemonLeague_ChampionsRoom_Frlg/scripts.inc",
+        "data/maps/PokemonTower_2F_Frlg/scripts.inc",
+        "data/maps/Route22_Frlg/scripts.inc",
+        "data/maps/SilphCo_7F_Frlg/scripts.inc",
+        "data/maps/SSAnne_2F_Corridor_Frlg/scripts.inc",
+    )
+    johto_starter_files = (
+        "data/maps/AzaleaTown/scripts.inc",
+        "data/maps/BurnedTower_1F/scripts.inc",
+        "data/maps/CherrygroveCity/scripts.inc",
+        "data/maps/GoldenrodCity_UndergroundSwitches/scripts.inc",
+        "data/maps/JohtoIndigoPlateau_PokemonCenter/scripts.inc",
+        "data/maps/NewBarkTown_Lab/scripts.inc",
+    )
+    for path in kanto_starter_files + johto_starter_files:
+        require(not re.search(r"\bVAR_STARTER_MON\b", read(path)), f"Shared starter var remains in {path}")
+
+    starter_choose = read("src/starter_choose.c")
+    require(
+        re.search(
+            r"\[REGION_KANTO\]\s*=\s*\{\s*SPECIES_BULBASAUR,\s*SPECIES_MUDKIP,\s*SPECIES_CYNDAQUIL\s*\}",
+            starter_choose,
+        ),
+        "Kanto starter order is not Bulbasaur, Mudkip, Cyndaquil",
+    )
+
+    pallet = read("data/maps/PalletTown_ProfessorOaksLab_Frlg/scripts.inc")
+    expected_ball_scripts = {
+        "BulbasaurBall": (0, "BULBASAUR", "MUDKIP", "SQUIRTLE"),
+        "SquirtleBall": (1, "MUDKIP", "CYNDAQUIL", "CHARMANDER"),
+        "CharmanderBall": (2, "CYNDAQUIL", "BULBASAUR", "BULBASAUR"),
+    }
+    for label, (slot, player_species, rival_species, rival_ball) in expected_ball_scripts.items():
+        pattern = (
+            rf"EventScript_{label}::.*?setvar PLAYER_STARTER_NUM, {slot}.*?"
+            rf"setvar PLAYER_STARTER_SPECIES, SPECIES_{player_species}.*?"
+            rf"setvar RIVAL_STARTER_SPECIES, SPECIES_{rival_species}.*?"
+            rf"setvar RIVAL_STARTER_ID, LOCALID_{rival_ball}_BALL"
+        )
+        require(re.search(pattern, pallet, re.DOTALL), f"{label} has an inconsistent player/rival mapping")
+
+    for slot, variant in ((0, "Squirtle"), (1, "Charmander"), (2, "Bulbasaur")):
+        require(
+            f"goto_if_eq PLAYER_STARTER_NUM, {slot}, PalletTown_ProfessorOaksLab_EventScript_RivalWalksTo{variant}" in pallet,
+            f"Gary does not walk to the correct ball for Kanto starter slot {slot}",
+        )
+
+    expected_variant_slots = {"Squirtle": 0, "Charmander": 1, "Bulbasaur": 2}
+    for path in kanto_starter_files:
+        script = read(path)
+        branches = re.findall(r"(?:goto|call)_if_eq VAR_STARTER_MON_FRLG, (\d), ([A-Za-z0-9_]+)", script)
+        for slot, target in branches:
+            for variant, expected_slot in expected_variant_slots.items():
+                if target.endswith(variant):
+                    require(
+                        int(slot) == expected_slot,
+                        f"{path} sends starter slot {slot} to Gary's {variant} team",
+                    )
+
+    rival_parties = read("src/data/trainers_frlg.party")
+    expected_rival_families = {
+        "SQUIRTLE": {"Mudkip", "Marshtomp", "Swampert"},
+        "BULBASAUR": {"Bulbasaur", "Ivysaur", "Venusaur"},
+        "CHARMANDER": {"Cyndaquil", "Quilava", "Typhlosion"},
+    }
+    rival_sections_checked = 0
+    for match in re.finditer(
+        r"^=== (TRAINER_(?:RIVAL|CHAMPION)[A-Z0-9_]+_(SQUIRTLE|BULBASAUR|CHARMANDER)) ===\n(.*?)(?=^=== |\Z)",
+        rival_parties,
+        re.MULTILINE | re.DOTALL,
+    ):
+        trainer_name, variant, section = match.groups()
+        mons = re.findall(r"^([A-Za-z][A-Za-z0-9 ._-]*?)(?: @ [^\n]+)?\nLevel:", section, re.MULTILINE)
+        require(mons, f"{trainer_name} has no party members")
+        require(
+            mons[-1] in expected_rival_families[variant],
+            f"{trainer_name} ends with {mons[-1]}, which does not match Gary's chosen starter",
+        )
+        move_blocks = re.findall(
+            r"^[A-Za-z][A-Za-z0-9 ._-]*?(?: @ [^\n]+)?\nLevel:.*?\nIVs:.*?\n(?:Ability:.*?\n)?((?:- [^\n]+\n)*)",
+            section,
+            re.MULTILINE,
+        )
+        for moves in move_blocks:
+            require(
+                len(moves.splitlines()) <= 4,
+                f"{trainer_name} has a PokÃ©mon with more than four moves",
+            )
+        rival_sections_checked += 1
+    require(rival_sections_checked >= 30, f"Only checked {rival_sections_checked} Gary starter teams")
+
+    new_bark = read("data/maps/NewBarkTown_Lab/scripts.inc")
+    for species in ("CHARMANDER", "TOTODILE", "TREECKO"):
+        require(f"SPECIES_{species}" in new_bark, f"Johto starter trio is missing {species}")
+    require("givemon PLAYER_STARTER_SPECIES, 5" in new_bark, "Johto starter is not level 5")
+
+    print("v0.4.3 Kanto validation passed: Gary, collection, encounters, and levels are correct.")
+
+
+if __name__ == "__main__":
+    main()
